{
 "patches": [
  {
   "id": "b025_ev1295_0002",
   "translation": "但步梦的温柔沁入心底……"
  },
  {
   "id": "b025_ev1295_0015",
   "translation": "我轻轻张开嘴。"
  },
  {
   "id": "b025_ev1295_0043",
   "translation": "「那，能帮我换下冰枕吗？」"
  },
  {
   "id": "b025_ev1295_0045",
   "translation": "「所以……啊——」",
   "note": "预算过紧，“来”字压缩"
  },
  {
   "id": "b025_ev1295_0047",
   "translation": "「冰枕啊。还有？」"
  },
  {
   "id": "b025_ev1295_0059",
   "translation": "「嗯……我明白」"
  },
  {
   "id": "b025_ev1295_0083",
   "translation": "「我想好好照顾你。哥哥好之前，都想好好照顾你……」"
  },
  {
   "id": "b025_ev1295_0112",
   "translation": "『到哥哥好起来为止……』"
  },
  {
   "id": "b025_ev1295_0124",
   "translation": "记得是换上T恤和四角裤、正要去拿睡衣的时候……",
   "note": "パジャマを取る=去拿睡衣（尚未穿上，参0150“怎么穿上的”疑问）"
  },
  {
   "id": "b025_ev1295_0151",
   "translation": "「量完了……」",
   "note": "预算过紧，维持初翻"
  },
  {
   "id": "b025_ev1295_0178",
   "translation": "「早安，怎样？」",
   "note": "预算过紧，维持初翻"
  },
  {
   "id": "b025_ev1295_0225",
   "translation": "虽然感冒倒下了，但今天是住宿研修的补休，总算不用请假。",
   "note": "代休按词表译补休"
  },
  {
   "id": "b025_ev1295_0241",
   "translation": "「啊，就是招待要花时间的意思」"
  },
  {
   "id": "b025_ev1295_0257",
   "translation": "「要是她没再说什么，大概一小时后会来……」"
  },
  {
   "id": "b025_ev1295_0294",
   "translation": "「3年里才2次而已……哥哥身体还真是好呢」"
  },
  {
   "id": "b025_ev1295_0313",
   "translation": "「进攻？攻什么……」"
  },
  {
   "id": "b025_ev1295_0352",
   "translation": "「客人？我先回避？」",
   "note": "改“先回避”，避免“碍事就走”读成驱赶对方"
  },
  {
   "id": "b025_ev1295_0377",
   "translation": "「唔……做点心，不只打扮，做事也很有女人味呢」"
  },
  {
   "id": "b025_ev1295_0381",
   "translation": "「知道啦……啊哈哈」"
  }
 ]
}