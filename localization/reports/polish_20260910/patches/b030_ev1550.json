{
 "patches": [
  {
   "id": "b030_ev1550_0005",
   "translation": "就算我行，步梦那边呢？"
  },
  {
   "id": "b030_ev1550_0013",
   "translation": "对方不是个人，是有名有信誉的大房地产公司。"
  },
  {
   "id": "b030_ev1550_0031",
   "translation": "一旦真相公开，届时同住关系就会解除吧。"
  },
  {
   "id": "b030_ev1550_0059",
   "translation": "还是小孩的我帮不上什么忙。"
  },
  {
   "id": "b030_ev1550_0068",
   "translation": "「……难道布丁也是你一个人做的？」"
  },
  {
   "id": "b030_ev1550_0084",
   "translation": "「呃……哥哥？」"
  },
  {
   "id": "b030_ev1550_0086",
   "translation": "「嗯嗯……不生气了？」"
  },
  {
   "id": "b030_ev1550_0096",
   "translation": "「是呢……剩下的事爸爸他们肯定会办好」"
  },
  {
   "id": "b030_ev1550_0130",
   "translation": "『哥哥生气也是……。』"
  },
  {
   "id": "b030_ev1550_0142",
   "translation": "毕竟对梦中哥哥，她能撒娇……对我也……"
  },
  {
   "id": "b030_ev1550_0143",
   "translation": "毕竟被闹钟叫醒，心情恐怕格外差吧。"
  },
  {
   "id": "b030_ev1550_0146",
   "translation": "呜呜呜！！"
  },
  {
   "id": "b030_ev1550_0174",
   "translation": "「还是现在这个家。下一个住户还没定下来，我们求房东给续了租」"
  },
  {
   "id": "b030_ev1550_0223",
   "translation": "奉莉一进教室就动员大家，同学们齐声响应。"
  },
  {
   "id": "b030_ev1550_0233",
   "translation": "「但、但请别误会！我、我才不是因为想穿女仆装才做的——」"
  },
  {
   "id": "b030_ev1550_0277",
   "translation": "好啦好啦",
   "note": "省略「」"
  },
  {
   "id": "b030_ev1550_0356",
   "translation": "步梦头也不回地应了声，继续干活。"
  },
  {
   "id": "b030_ev1550_0389",
   "translation": "「怎么？明明超合适哦？」"
  },
  {
   "id": "b030_ev1550_0401",
   "translation": "「吃咯……」"
  },
  {
   "id": "b030_ev1550_0435",
   "translation": "「欢迎回来，主人——！」"
  },
  {
   "id": "b030_ev1550_0442",
   "translation": "「不是不行……妹妹是未玖！」"
  },
  {
   "id": "b030_ev1550_0461",
   "translation": "「对啦，来嘛哥哥！」"
  },
  {
   "id": "b030_ev1550_0462",
   "translation": "「以后！现在是妹妹！」"
  },
  {
   "id": "b030_ev1550_0480",
   "translation": "哇，看着就好吃！",
   "note": "省略「」"
  },
  {
   "id": "b030_ev1550_0495",
   "translation": "然后，步梦去了厨房区。"
  }
 ]
}