{
 "patches": [
  {
   "id": "b069_ev4345_0029",
   "translation": "「好期待呢～」"
  },
  {
   "id": "b069_ev4345_0040",
   "translation": "「啊，就算是11点10分那场，6人连座似乎也勉强」"
  },
  {
   "id": "b069_ev4345_0053",
   "translation": "「这么一问，一时想不出来啊」"
  },
  {
   "id": "b069_ev4345_0074",
   "translation": "电影？",
   "note": "预算紧省略「」"
  },
  {
   "id": "b069_ev4345_0076",
   "translation": "「等有空了，我们也两个人单独去看吧」"
  },
  {
   "id": "b069_ev4345_0088",
   "translation": "「嘛，我只是稍微帮了点忙。多亏拜田同学拼命努力」"
  },
  {
   "id": "b069_ev4345_0096",
   "translation": "走向电影院时，趁走成并排的时机，我向拜田同学搭话。"
  },
  {
   "id": "b069_ev4345_0098",
   "translation": "我们付了钱，从章介那里拿到票，朝影厅走去。"
  },
  {
   "id": "b069_ev4345_0101",
   "translation": "人群一角人少的地方有台终端机，章介操作它出了票。"
  },
  {
   "id": "b069_ev4345_0138",
   "translation": "「嗯。合宿那晚我就觉得，一聊到喜欢的话题你就变得特别健谈呢」"
  },
  {
   "id": "b069_ev4345_0144",
   "translation": "「呃……现在10点19分。离集合还有25分多钟，还没人来呢」"
  },
  {
   "id": "b069_ev4345_0159",
   "translation": "「哪、哪用道歉……」"
  },
  {
   "id": "b069_ev4345_0163",
   "translation": "「是。平时总是我在道歉……」"
  },
  {
   "id": "b069_ev4345_0170",
   "translation": "「嗯？横山还没来啊……」"
  },
  {
   "id": "b069_ev4345_0198",
   "translation": "男孩相当狠毒地背叛了主人公。"
  },
  {
   "id": "b069_ev4345_0205",
   "translation": "「……然后，听说这电影超虐心，结局必定大哭」"
  },
  {
   "id": "b069_ev4345_0215",
   "translation": "「变成两个人……」"
  },
  {
   "id": "b069_ev4345_0250",
   "translation": "――之后讨论了很多，没人提出比拜田方案更好的。"
  },
  {
   "id": "b069_ev4345_0254",
   "translation": "『拜田同学说电影认真消化了原作又有新解读，我现在懂这话的意思了』"
  },
  {
   "id": "b069_ev4345_0262",
   "translation": "『问题的答案：借给三谷君的是文库版』"
  },
  {
   "id": "b069_ev4345_0266",
   "translation": "听到『拜田』之名，我回了神。"
  },
  {
   "id": "b069_ev4345_0271",
   "translation": "『已经很晚了，感想就到学校再讲给我听吧？』"
  },
  {
   "id": "b069_ev4345_0280",
   "translation": "顿了一下。"
  },
  {
   "id": "b069_ev4345_0299",
   "translation": "在洗场任务后对我说过想改变的拜田同学。"
  },
  {
   "id": "b069_ev4345_0303",
   "translation": "发现自己一直盯着拜田同学看，慌忙把视线移向空中。"
  },
  {
   "id": "b069_ev4345_0306",
   "translation": "拜田同学脸一红，羞涩地点了点头。"
  },
  {
   "id": "b069_ev4345_0313",
   "translation": "我完全沉浸在故事主人公的温柔心情里。"
  },
  {
   "id": "b069_ev4345_0316",
   "translation": "记得有谁说过，读书就是重新体验一段人生。"
  },
  {
   "id": "b069_ev4345_0328",
   "translation": "「您觉得呢……」"
  },
  {
   "id": "b069_ev4345_0331",
   "translation": "「泡芙的点子并不是我原创的。是三谷君的叔叔想出来的」"
  },
  {
   "id": "b069_ev4345_0335",
   "translation": "「风险虽高，押中了就能获得高评价。想求一击逆转就值得一试――就是这样」"
  },
  {
   "id": "b069_ev4345_0337",
   "translation": "「原作书还借着拜田同学的呢」"
  },
  {
   "id": "b069_ev4345_0339",
   "translation": "「说来惭愧，也有让我眼眶发热的场面。可以坦率称赞很出色」"
  },
  {
   "id": "b069_ev4345_0349",
   "translation": "「我也记得是这么说的。大概因为稳妥吧」"
  },
  {
   "id": "b069_ev4345_0374",
   "translation": "「每、每次看都可爱」"
  },
  {
   "id": "b069_ev4345_0387",
   "translation": "「呃，那个先放一边。有件事和《天使之泪》无关，我想今天先说一下」"
  },
  {
   "id": "b069_ev4345_0391",
   "translation": "「好可爱」"
  },
  {
   "id": "b069_ev4345_0392",
   "translation": "「这、这不能当没听见，我现在是男生不是女孩――」"
  },
  {
   "id": "b069_ev4345_0413",
   "translation": "「不坦率的真央酱也可爱～」"
  }
 ]
}