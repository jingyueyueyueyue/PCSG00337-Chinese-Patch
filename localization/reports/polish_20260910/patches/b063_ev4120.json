{
 "patches": [
  {
   "id": "b063_ev4120_0007",
   "translation": "两人独处会更容易鼓励她……"
  },
  {
   "id": "b063_ev4120_0018",
   "translation": "「……看着没精神吗……？」"
  },
  {
   "id": "b063_ev4120_0020",
   "translation": "「拜田同学？」",
   "note": "预算紧省略号"
  },
  {
   "id": "b063_ev4120_0025",
   "translation": "「那，是不甘心才哭？」"
  },
  {
   "id": "b063_ev4120_0033",
   "translation": "「可、可是……又、又要给三谷君……呜……添麻烦……」"
  },
  {
   "id": "b063_ev4120_0041",
   "translation": "「三谷君、奉莉、步梦、真央、横山君……遇见了超棒的大家……」"
  },
  {
   "id": "b063_ev4120_0042",
   "translation": "「三谷君应该也明白……我从以前就畏畏缩缩……很胆小……」"
  },
  {
   "id": "b063_ev4120_0044",
   "translation": "「有资格吗」",
   "note": "预算紧省略？"
  },
  {
   "id": "b063_ev4120_0055",
   "translation": "「呜……吸……」"
  },
  {
   "id": "b063_ev4120_0067",
   "translation": "「呃，三谷陆斗君和拜田希实花呢？」"
  },
  {
   "id": "b063_ev4120_0094",
   "translation": "我和拜田同学在大家目送下跟上负责人。"
  },
  {
   "id": "b063_ev4120_0099",
   "translation": "缓缓点了点头……"
  },
  {
   "id": "b063_ev4120_0142",
   "translation": "「对、对不起。叫大家来的不是三谷君，其实是我……」"
  },
  {
   "id": "b063_ev4120_0150",
   "translation": "「是。可以的话，想推出三谷君叔叔店里卖的甜点……」"
  },
  {
   "id": "b063_ev4120_0152",
   "translation": "「没人放弃吧？」"
  },
  {
   "id": "b063_ev4120_0163",
   "translation": "听了大家的话，拜田同学再次深深低头。"
  },
  {
   "id": "b063_ev4120_0165",
   "translation": "但作为书记，总得先确认准确才行……"
  },
  {
   "id": "b063_ev4120_0173",
   "translation": "听到这个意见，前排的奉莉她们互相交换视线，最后目光落到站在讲台前的拜田同学身上。"
  },
  {
   "id": "b063_ev4120_0177",
   "translation": "向拜田同学报告，在黑板上写『32』。"
  },
  {
   "id": "b063_ev4120_0182",
   "translation": "拜田同学用清晰的声音说道。"
  },
  {
   "id": "b063_ev4120_0190",
   "translation": "「委员们事先商量过，结论是提议办『以女仆咖啡店为基础的模拟店』」"
  },
  {
   "id": "b063_ev4120_0200",
   "translation": "「那，三谷君……」"
  },
  {
   "id": "b063_ev4120_0215",
   "translation": "「关、关于这点，委员们也掌握了这个问题，正在考虑增加一款」"
  },
  {
   "id": "b063_ev4120_0219",
   "translation": "「好、好像没有特别的提问，那么我想先就以女仆咖啡店为基础的模拟店进行表决」"
  },
  {
   "id": "b063_ev4120_0223",
   "translation": "「是、是。三谷君他们的爸爸开了一家西点店，叫ｅｅｎ×ｖｉｊｆ……」"
  },
  {
   "id": "b063_ev4120_0224",
   "translation": "「是。那么三谷君担任书记……」"
  },
  {
   "id": "b063_ev4120_0227",
   "translation": "「大、大家，感谢各位举手。赞成32票超过半数，决定采用『以女仆咖啡店为基础的模拟店』」"
  },
  {
   "id": "b063_ev4120_0235",
   "translation": "毕竟一个人定不了，拜田同学开始慌张起来。"
  },
  {
   "id": "b063_ev4120_0251",
   "translation": "拜田同学像死心似的移开视线。"
  },
  {
   "id": "b063_ev4120_0257",
   "translation": "「……怎么了？」"
  },
  {
   "id": "b063_ev4120_0263",
   "translation": "「有劳拜田同学」"
  },
  {
   "id": "b063_ev4120_0276",
   "translation": "「那，我也想去啊」"
  },
  {
   "id": "b063_ev4120_0283",
   "translation": "「泡、泡芙……」"
  },
  {
   "id": "b063_ev4120_0292",
   "translation": "「我是三谷君和步梦小姐的同班同学，担、担任活动委员长的拜、拜田」"
  },
  {
   "id": "b063_ev4120_0303",
   "translation": "「步梦小姐！」"
  },
  {
   "id": "b063_ev4120_0304",
   "translation": "「那，三谷君，我来说」"
  },
  {
   "id": "b063_ev4120_0316",
   "translation": "「嗯，拜田同学的心我懂」"
  },
  {
   "id": "b063_ev4120_0325",
   "translation": "「这么周到，谢谢。陆斗和步梦平时承蒙关照」"
  },
  {
   "id": "b063_ev4120_0335",
   "translation": "「请稍等……老板！陆斗君他们来啦！」"
  }
 ]
}