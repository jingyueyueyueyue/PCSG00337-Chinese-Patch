{
 "patches": [
  {
   "id": "b053_ev3435_0011",
   "translation": "「不用管我。好好睡觉，为明天做准备吧」"
  },
  {
   "id": "b053_ev3435_0013",
   "translation": "「嗯、嗯」"
  },
  {
   "id": "b053_ev3435_0021",
   "translation": "（……为什么，我会睡在这里呢？）"
  },
  {
   "id": "b053_ev3435_0037",
   "translation": "（不存在的未来……）"
  },
  {
   "id": "b053_ev3435_0095",
   "translation": "「哎呀」"
  },
  {
   "id": "b053_ev3435_0104",
   "translation": "总之，照吩咐在餐桌前坐下。"
  },
  {
   "id": "b053_ev3435_0118",
   "translation": "「……谢谢，解决了一个烦恼」"
  },
  {
   "id": "b053_ev3435_0133",
   "translation": "「原来那样就行啊」"
  },
  {
   "id": "b053_ev3435_0144",
   "translation": "奉莉烦恼的一角……"
  },
  {
   "id": "b053_ev3435_0172",
   "translation": "步梦是男孩这话已经成了谎话，我觉得有必要告诉未玖。"
  },
  {
   "id": "b053_ev3435_0176",
   "translation": "未玖自己想通了。"
  },
  {
   "id": "b053_ev3435_0195",
   "translation": "「3号桌，有客人点单了」"
  },
  {
   "id": "b053_ev3435_0207",
   "translation": "「又来一单——指名三谷同学」"
  },
  {
   "id": "b053_ev3435_0211",
   "translation": "「爱恋扑通扑通抱抱滚！」",
   "note": "按词表统一咒语译名"
  },
  {
   "id": "b053_ev3435_0242",
   "translation": "「这事我也会向东云小姐说明」"
  },
  {
   "id": "b053_ev3435_0244",
   "translation": "「好。步梦小姐特制！」"
  },
  {
   "id": "b053_ev3435_0270",
   "translation": "「好的。这粉色奶油上点缀的草莓……足以看出步梦小姐对父亲大人的深深敬意！」"
  },
  {
   "id": "b053_ev3435_0272",
   "translation": "「好，既然三谷前辈这么说」"
  },
  {
   "id": "b053_ev3435_0278",
   "translation": "「哎呀」"
  },
  {
   "id": "b053_ev3435_0302",
   "translation": "虽然完全不懂她想通了什么……"
  },
  {
   "id": "b053_ev3435_0306",
   "translation": "正是当之无愧的人气第一。",
   "note": "按词表泛指语境译人气第一"
  }
 ]
}