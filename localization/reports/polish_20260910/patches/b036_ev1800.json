{
 "patches": [
  {
   "id": "b036_ev1800_0009",
   "translation": "一直挥手到奉莉的身影变小，我和步梦才朝家走去。"
  },
  {
   "id": "b036_ev1800_0052",
   "translation": "「嗯，本想做到告一段落再停手的……结果做服装意外花了时间……」"
  },
  {
   "id": "b036_ev1800_0061",
   "translation": "「晚上好，未玖酱」"
  },
  {
   "id": "b036_ev1800_0068",
   "translation": "「比起这个，今天是妈妈做的饭哦」",
   "note": "预算过紧，楽しみだね省略"
  },
  {
   "id": "b036_ev1800_0094",
   "translation": "可是做饭的不是妈妈……"
  },
  {
   "id": "b036_ev1800_0112",
   "translation": "颤抖的手勉强夹起，吃了一口亲子饭。"
  },
  {
   "id": "b036_ev1800_0117",
   "translation": "和妈妈做的那份亲子饭……一模一样……"
  },
  {
   "id": "b036_ev1800_0118",
   "translation": "眼前是一份非常诱人的亲子饭。"
  },
  {
   "id": "b036_ev1800_0121",
   "translation": "擦着泪，筷子伸向亲子饭。"
  },
  {
   "id": "b036_ev1800_0133",
   "translation": "「陆斗君？」"
  },
  {
   "id": "b036_ev1800_0143",
   "translation": "「久等了，陆斗君」"
  },
  {
   "id": "b036_ev1800_0153",
   "translation": "这是复刻妈妈的亲子饭。"
  },
  {
   "id": "b036_ev1800_0181",
   "translation": "给我做亲子饭的妈妈……"
  },
  {
   "id": "b036_ev1800_0208",
   "translation": "「……只有一个」"
  },
  {
   "id": "b036_ev1800_0222",
   "translation": "「听爸爸说了。你们什么都不知道」"
  },
  {
   "id": "b036_ev1800_0224",
   "translation": "「步梦说得对。我们太不小心了，对不起，陆斗君」"
  },
  {
   "id": "b036_ev1800_0226",
   "translation": "「我最爱妈妈的亲子饭了，世界第一！！」"
  },
  {
   "id": "b036_ev1800_0230",
   "translation": "「我能和良子小姐成为家人……但成不了母子……绝对、成不了……」"
  },
  {
   "id": "b036_ev1800_0232",
   "translation": "「那个，良子」",
   "note": "预算过紧，さん省略"
  },
  {
   "id": "b036_ev1800_0236",
   "translation": "「不……最近感觉快和良子小姐成为家人了……」"
  },
  {
   "id": "b036_ev1800_0237",
   "translation": "「不，是我不好，步梦。明明有吃不了的东西，却没好好告诉良子小姐」"
  },
  {
   "id": "b036_ev1800_0241",
   "translation": "「嗯，但妈妈的亲子饭太好吃了……啊呜」"
  },
  {
   "id": "b036_ev1800_0242",
   "translation": "「是呢。这次一定要让陆斗君笑着吃我做的菜」"
  },
  {
   "id": "b036_ev1800_0246",
   "translation": "「怎么会，错的是我们」"
  },
  {
   "id": "b036_ev1800_0247",
   "translation": "「那我去向良子小姐和步梦道歉」"
  },
  {
   "id": "b036_ev1800_0250",
   "translation": "「就是说……和良子成不了家人……？」"
  },
  {
   "id": "b036_ev1800_0252",
   "translation": "「只是，两人都没那个意思。良子只是忠实复刻了我给的菜谱……对步梦也只字未提内情」"
  },
  {
   "id": "b036_ev1800_0254",
   "translation": "「所以，陆斗君」"
  },
  {
   "id": "b036_ev1800_0256",
   "translation": "「今天的是陆斗最爱的亲子饭！」"
  },
  {
   "id": "b036_ev1800_0259",
   "translation": "「哇，妈妈滑蛋的亲子饭！！」"
  },
  {
   "id": "b036_ev1800_0287",
   "translation": "「……怎么办？」"
  },
  {
   "id": "b036_ev1800_0289",
   "translation": "「……步梦会高兴的」"
  },
  {
   "id": "b036_ev1800_0294",
   "translation": "「那么，让我听听吧？」"
  },
  {
   "id": "b036_ev1800_0298",
   "translation": "「期待哦」"
  },
  {
   "id": "b036_ev1800_0304",
   "translation": "「社团组没问题。她们会配合得很好」"
  },
  {
   "id": "b036_ev1800_0309",
   "translation": "「陆斗跳得比谁都好，早晚各练一次就没问题」"
  },
  {
   "id": "b036_ev1800_0312",
   "translation": "「我出门了」"
  },
  {
   "id": "b036_ev1800_0318",
   "translation": "「其实……」"
  },
  {
   "id": "b036_ev1800_0328",
   "translation": "「是啊，最近一直晴呢」"
  },
  {
   "id": "b036_ev1800_0348",
   "translation": "「还行吧」"
  },
  {
   "id": "b036_ev1800_0351",
   "translation": "「和陆斗？」"
  }
 ]
}