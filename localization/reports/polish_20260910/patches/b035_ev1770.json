{
 "patches": [
  {
   "id": "b035_ev1770_0007",
   "translation": "可刚才步梦确实一脸凶相……"
  },
  {
   "id": "b035_ev1770_0032",
   "translation": "就在步梦慌乱不已时，导演朝这边走来。"
  },
  {
   "id": "b035_ev1770_0040",
   "translation": "良子小姐特意拜托，实在没法拒绝。"
  },
  {
   "id": "b035_ev1770_0092",
   "translation": "「良子吗」",
   "note": "预算紧省略问号；良子さん拟统一良子小姐，但预算放不下"
  },
  {
   "id": "b035_ev1770_0112",
   "translation": "「嗯、嗯……吃醋吗？做得来吗」",
   "note": ""
  },
  {
   "id": "b035_ev1770_0138",
   "translation": "「才没？」"
  },
  {
   "id": "b035_ev1770_0140",
   "translation": "「也是……不过良子小姐都拜托了……」"
  },
  {
   "id": "b035_ev1770_0194",
   "translation": "「我、我也……最喜欢了……真的、最喜欢……」"
  },
  {
   "id": "b035_ev1770_0204",
   "translation": "到底是什么契机会让步梦进入不高兴模式……？"
  },
  {
   "id": "b035_ev1770_0209",
   "translation": "这么僵硬的两个人，真能挑起大梁吗……？"
  },
  {
   "id": "b035_ev1770_0279",
   "translation": "「太好了……」"
  },
  {
   "id": "b035_ev1770_0303",
   "translation": "让我想答案，就说明事情还没到不马上处理就不行的地步吧。"
  },
  {
   "id": "b035_ev1770_0313",
   "translation": "「其、其实，我和步梦……当了那剧的群演」"
  },
  {
   "id": "b035_ev1770_0316",
   "translation": "「就……演恋人……」"
  },
  {
   "id": "b035_ev1770_0327",
   "translation": "「要我察觉？」"
  },
  {
   "id": "b035_ev1770_0338",
   "translation": "「不……因为……」"
  },
  {
   "id": "b035_ev1770_0345",
   "translation": "「呃……演恋人……」"
  },
  {
   "id": "b035_ev1770_0351",
   "translation": "「这样啊……那演什么角色？」"
  },
  {
   "id": "b035_ev1770_0357",
   "translation": "「害、害羞死了……和哥哥演恋人……」"
  }
 ]
}