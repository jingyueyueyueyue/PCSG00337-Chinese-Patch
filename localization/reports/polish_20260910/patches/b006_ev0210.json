{
 "patches": [
  {
   "id": "b006_ev0210_0006",
   "translation": "「……怎么不说话？」"
  },
  {
   "id": "b006_ev0210_0008",
   "translation": "「你觉得那家伙跟我告白，才会尴尬？」"
  },
  {
   "id": "b006_ev0210_0017",
   "translation": "「首先，这种展开怎么可能交往」"
  },
  {
   "id": "b006_ev0210_0018",
   "translation": "「对吧。考虑到他想在初中最后做个了断的心情，我可不能随便敷衍了事」"
  },
  {
   "id": "b006_ev0210_0024",
   "translation": "「不止我一个人。坐这趟缆车的所有人都这么想」"
  },
  {
   "id": "b006_ev0210_0026",
   "translation": "「要说见过……我正要坐摩天轮时，正好看见她下来了」"
  },
  {
   "id": "b006_ev0210_0029",
   "translation": "「我才不可怜呢」"
  },
  {
   "id": "b006_ev0210_0060",
   "translation": "「话是没错……」"
  },
  {
   "id": "b006_ev0210_0087",
   "translation": "「那，听陆斗劝的话……步梦肯定会趁你睡着下手吧？」"
  },
  {
   "id": "b006_ev0210_0105",
   "translation": "「陆斗君？我是良子」"
  },
  {
   "id": "b006_ev0210_0106",
   "translation": "「良子小姐，早上好」"
  },
  {
   "id": "b006_ev0210_0125",
   "translation": "「对。去偷袭睡着的步梦」"
  },
  {
   "id": "b006_ev0210_0142",
   "translation": "「不过入学式肯定能见到，就把这当成多了想象步梦是什么人的时间，不也挺好吗？」"
  },
  {
   "id": "b006_ev0210_0218",
   "translation": "「当然了！！」"
  },
  {
   "id": "b006_ev0210_0246",
   "translation": "「来，淑女，走吧」"
  },
  {
   "id": "b006_ev0210_0256",
   "translation": "「那位绅士，帮个忙？」"
  },
  {
   "id": "b006_ev0210_0264",
   "translation": "「是、是……明白了」"
  },
  {
   "id": "b006_ev0210_0306",
   "translation": "视线汇聚——"
  },
  {
   "id": "b006_ev0210_0311",
   "translation": "目光长远……从老师嘴里说出来好吗？"
  },
  {
   "id": "b006_ev0210_0344",
   "translation": "「森、森老师！您在学生席干嘛？」"
  },
  {
   "id": "b006_ev0210_0359",
   "translation": "自顾自定好规则后，奉莉开始了自我介绍。"
  },
  {
   "id": "b006_ev0210_0382",
   "translation": "没什么好犹豫的，就按横山君说的排进中间——"
  },
  {
   "id": "b006_ev0210_0393",
   "translation": "旁边一列传来惊讶声。"
  },
  {
   "id": "b006_ev0210_0400",
   "translation": "「Mi、ta、ni……真是啊」"
  },
  {
   "id": "b006_ev0210_0421",
   "translation": "「横山章介，绅士」"
  },
  {
   "id": "b006_ev0210_0440",
   "translation": "「非常感谢您，三谷君……诶！？」"
  },
  {
   "id": "b006_ev0210_0529",
   "translation": "「嘛，绅士不会为这点小事生气……三谷君的女友说话可真直率」"
  },
  {
   "id": "b006_ev0210_0001",
   "translation": "和奉莉两人的归途——",
   "note": "预算过紧"
  },
  {
   "id": "b006_ev0210_0043",
   "translation": "「呃……奉莉？」",
   "note": "预算过紧"
  },
  {
   "id": "b006_ev0210_0133",
   "translation": "「等!? 那、那也太……」",
   "note": "预算过紧"
  },
  {
   "id": "b006_ev0210_0184",
   "translation": "「……咋办」",
   "note": "预算过紧"
  },
  {
   "id": "b006_ev0210_0249",
   "translation": "「去保健室……」",
   "note": "预算过紧"
  },
  {
   "id": "b006_ev0210_0436",
   "translation": "「累了」",
   "note": "预算过紧"
  },
  {
   "id": "b006_ev0210_0534",
   "translation": "「哟，好久不见」",
   "note": "预算过紧"
  }
 ]
}