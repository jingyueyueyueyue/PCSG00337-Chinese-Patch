{
 "patches": [
  {
   "id": "b090_ev5640_0001",
   "translation": "……还是直接打个电话？"
  },
  {
   "id": "b090_ev5640_0028",
   "translation": "「那，那个……」"
  },
  {
   "id": "b090_ev5640_0043",
   "translation": "「我这边完全没问题……你呢？有安排吗？」"
  },
  {
   "id": "b090_ev5640_0062",
   "translation": "不过他对恋人练习这件事好像挺支持，应该不会被骂……"
  },
  {
   "id": "b090_ev5640_0065",
   "translation": "心脏咚地一跳，幸福感在胸中蔓延开来。"
  },
  {
   "id": "b090_ev5640_0066",
   "translation": "回过神来，真央酱攥紧了牵着的手。"
  },
  {
   "id": "b090_ev5640_0080",
   "translation": "「这不是为了让真央酱解除破门吗？真交往算怎么回事？」"
  },
  {
   "id": "b090_ev5640_0086",
   "translation": "「交到真男友就等于懂了女人心，一口气冲到终点」"
  },
  {
   "id": "b090_ev5640_0091",
   "translation": "「事到如今，跟真央酱认真交往？」"
  },
  {
   "id": "b090_ev5640_0092",
   "translation": "「没那回事。越来越像恋人，感觉很好哦！」"
  },
  {
   "id": "b090_ev5640_0093",
   "translation": "「那种事老爷爷不会答应」",
   "note": "预算紧省略句尾省略号"
  },
  {
   "id": "b090_ev5640_0128",
   "translation": "「真央酱，怎么了？」",
   "note": "预算紧省略前导省略号"
  },
  {
   "id": "b090_ev5640_0135",
   "translation": "「……这么一看，三谷君挺帅的呢」"
  },
  {
   "id": "b090_ev5640_0144",
   "translation": "「毕竟三谷君身边还有奈奈濑同学她们嘛」"
  },
  {
   "id": "b090_ev5640_0146",
   "translation": "然后照意见马上试缝了好几款，决定先找个人穿上看看"
  },
  {
   "id": "b090_ev5640_0147",
   "translation": "「也想看看和帽子的搭配效果」"
  },
  {
   "id": "b090_ev5640_0153",
   "translation": "「光好看可跳不了舞。而且我也庆幸这次做了幕后」"
  },
  {
   "id": "b090_ev5640_0155",
   "translation": "「三谷君，等等」"
  },
  {
   "id": "b090_ev5640_0161",
   "translation": "「破门解除就变回男生来着？」"
  },
  {
   "id": "b090_ev5640_0166",
   "translation": "「谢谢。那么请先试这件……」"
  },
  {
   "id": "b090_ev5640_0170",
   "translation": "「嗯。想请你们试穿服装」"
  },
  {
   "id": "b090_ev5640_0179",
   "translation": "「这布后面，三谷君正……」"
  },
  {
   "id": "b090_ev5640_0180",
   "translation": "「绳头……这样勾住……」"
  },
  {
   "id": "b090_ev5640_0181",
   "translation": "「和三谷君的关系就此结束」",
   "note": "预算紧省略句尾省略号"
  },
  {
   "id": "b090_ev5640_0185",
   "translation": "「就是说三谷君恢复单身了」",
   "note": "预算紧省略句尾省略号"
  },
  {
   "id": "b090_ev5640_0189",
   "translation": "「果然这里得来个意外，布哗啦一下掉下来……」"
  },
  {
   "id": "b090_ev5640_0193",
   "translation": "那也太过了……"
  },
  {
   "id": "b090_ev5640_0198",
   "translation": "对，就像还是男孩时的真央酱。"
  },
  {
   "id": "b090_ev5640_0219",
   "translation": "真央酱轻轻靠了过来，仿佛把出校门起就一直牵着的手也卷了进来。"
  },
  {
   "id": "b090_ev5640_0254",
   "translation": "……想问终点在哪。"
  },
  {
   "id": "b090_ev5640_0260",
   "translation": "但还差几步才到终点……？"
  },
  {
   "id": "b090_ev5640_0274",
   "translation": "「……怎么了」",
   "note": "预算紧省略问号"
  },
  {
   "id": "b090_ev5640_0278",
   "translation": "「……肯定没事」"
  },
  {
   "id": "b090_ev5640_0279",
   "translation": "「……那么，真央去准备饭可好？」"
  },
  {
   "id": "b090_ev5640_0281",
   "translation": "「……不见得哦」"
  },
  {
   "id": "b090_ev5640_0296",
   "translation": "「不行的话，他大概不会让我们牵手」"
  },
  {
   "id": "b090_ev5640_0301",
   "translation": "「真央对你说喜欢，你会怎样？」"
  },
  {
   "id": "b090_ev5640_0302",
   "translation": "「不想吃真央做的饭？」"
  },
  {
   "id": "b090_ev5640_0318",
   "translation": "「诶，可是，会打扰吧」",
   "note": "预算紧省略问号"
  },
  {
   "id": "b090_ev5640_0321",
   "translation": "「叫我对老爷爷别紧张，也办不到啊」"
  },
  {
   "id": "b090_ev5640_0331",
   "translation": "「我说过马上回来吧」"
  },
  {
   "id": "b090_ev5640_0335",
   "translation": "「是啊……」"
  },
  {
   "id": "b090_ev5640_0353",
   "translation": "「答案呢？」"
  },
  {
   "id": "b090_ev5640_0356",
   "translation": "「你的心意我很明白了。今后真央也拜托你了」"
  }
 ]
}