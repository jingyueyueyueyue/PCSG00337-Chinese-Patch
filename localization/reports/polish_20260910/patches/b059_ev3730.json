{
 "patches": [
  {
   "id": "b059_ev3730_0005",
   "translation": "奉莉温柔摸着怀里喜极而泣的步梦的头。",
   "note": "补出「自分の胸で」细节：步梦伏在奉莉怀里"
  },
  {
   "id": "b059_ev3730_0016",
   "translation": "「……总感觉像真的在交往一样呢」"
  },
  {
   "id": "b059_ev3730_0017",
   "translation": "「可是……可是……呜……太好了……」",
   "note": "补出呜咽声ううぅ"
  },
  {
   "id": "b059_ev3730_0054",
   "translation": "「那么……我和奉莉，从昨天开始交往了」"
  },
  {
   "id": "b059_ev3730_0122",
   "translation": "「对了，有件事我从昨天就在想」"
  },
  {
   "id": "b059_ev3730_0167",
   "translation": "「所以三谷君今天就到此为止，为明天养精蓄锐吧」",
   "note": "三谷くん按称呼规则改三谷君"
  },
  {
   "id": "b059_ev3730_0174",
   "translation": "赢得大家的掌声喝彩。"
  },
  {
   "id": "b059_ev3730_0181",
   "translation": "为什么会变，我当然清楚。"
  },
  {
   "id": "b059_ev3730_0191",
   "translation": "被伙伴们推了一把，我和奉莉离校约会去了。"
  },
  {
   "id": "b059_ev3730_0249",
   "translation": "「我也懂奉莉的心情」"
  },
  {
   "id": "b059_ev3730_0250",
   "translation": "「这里可以举办各种活动，不过这次是婚礼」"
  },
  {
   "id": "b059_ev3730_0268",
   "translation": "「顺便问下，包场的人都会做些什么？」"
  },
  {
   "id": "b059_ev3730_0290",
   "translation": "所谓带孩子的婚礼……"
  },
  {
   "id": "b059_ev3730_0292",
   "translation": "不过这样也许更好，不会被人看出表情。"
  },
  {
   "id": "b059_ev3730_0293",
   "translation": "刚才还羡慕望着新娘的奉莉，神色忽然变了。"
  },
  {
   "id": "b059_ev3730_0296",
   "translation": "说着，这次把自己的鲷鱼烧递了过来。"
  }
 ]
}