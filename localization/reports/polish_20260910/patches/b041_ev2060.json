{
 "patches": [
  {
   "id": "b041_ev2060_0033",
   "translation": "多多少少都会给大家添麻烦的……"
  },
  {
   "id": "b041_ev2060_0084",
   "translation": "「好、好的……那就拜托您了？」"
  },
  {
   "id": "b041_ev2060_0132",
   "translation": "「家里有备着应急用的钱对吧？」"
  },
  {
   "id": "b041_ev2060_0149",
   "translation": "「步梦回了吗」",
   "note": "预算紧，省略问号"
  },
  {
   "id": "b041_ev2060_0174",
   "translation": "「诶？还有……」"
  },
  {
   "id": "b041_ev2060_0183",
   "translation": "「也没联系吗？」"
  },
  {
   "id": "b041_ev2060_0240",
   "translation": "「不行……车开过去了」",
   "note": "修正误译：いっちゃいました指车驶过未停，非昏倒"
  },
  {
   "id": "b041_ev2060_0241",
   "translation": "「……老爷爷！？」"
  },
  {
   "id": "b041_ev2060_0296",
   "translation": "「肋、肋骨……糟了！得赶紧处理！」"
  },
  {
   "id": "b041_ev2060_0341",
   "translation": "（等等，有光？是车吗？）"
  }
 ]
}