{
 "patches": [
  {
   "id": "b054_ev3480_0001",
   "translation": "客人B"
  },
  {
   "id": "b054_ev3480_0015",
   "translation": "「哦，对了」"
  },
  {
   "id": "b054_ev3480_0026",
   "translation": "说着，章介把视线投向客席。"
  },
  {
   "id": "b054_ev3480_0028",
   "translation": "我也跟着看向客席。"
  },
  {
   "id": "b054_ev3480_0032",
   "translation": "意外的结果让全班哗然。"
  },
  {
   "id": "b054_ev3480_0062",
   "translation": "「喏，拜托」"
  },
  {
   "id": "b054_ev3480_0065",
   "translation": "「现在最好快点转换心情，把目光转向下一步」"
  },
  {
   "id": "b054_ev3480_0081",
   "translation": "「嘛，考虑销售额，我觉得是正确的判断。每次都填单子的话，翻台速度就会变慢」"
  },
  {
   "id": "b054_ev3480_0084",
   "translation": "不过收拾基本已经结束，应援组正在做最后的垃圾收集。"
  },
  {
   "id": "b054_ev3480_0105",
   "translation": "「……可你看起来还没想通哦？」"
  },
  {
   "id": "b054_ev3480_0114",
   "translation": "「……呃，奉莉解释的？」"
  },
  {
   "id": "b054_ev3480_0117",
   "translation": "「……为什么妹弟要代替哥哥来解释？」",
   "note": "删ruby"
  },
  {
   "id": "b054_ev3480_0138",
   "translation": "「你们俩真是辛苦了——」"
  },
  {
   "id": "b054_ev3480_0148",
   "translation": "「未玖从今天起跟哥哥们一起睡！」"
  },
  {
   "id": "b054_ev3480_0217",
   "translation": "不过，睡我旁边当奖品真的行吗？"
  },
  {
   "id": "b054_ev3480_0261",
   "translation": "「让孩子多的哥哥分你一个？」"
  },
  {
   "id": "b054_ev3480_0266",
   "translation": "「继续……把未玖的棋子退回去」"
  },
  {
   "id": "b054_ev3480_0287",
   "translation": "「要拿肚子药？」"
  },
  {
   "id": "b054_ev3480_0312",
   "translation": "……怎么办？"
  },
  {
   "id": "b054_ev3480_0313",
   "translation": "……今天也很怪。",
   "note": ""
  },
  {
   "id": "b054_ev3480_0316",
   "translation": "……已不知该说什么才好。"
  },
  {
   "id": "b054_ev3480_0317",
   "translation": "……本来打算和未玖睡的。"
  },
  {
   "id": "b054_ev3480_0359",
   "translation": "「……能问一个吗？」",
   "note": ""
  },
  {
   "id": "b054_ev3480_0361",
   "translation": "「……睡吧？」",
   "note": ""
  },
  {
   "id": "b054_ev3480_0373",
   "translation": "「谢谢你回答我……呜……谢谢……」"
  },
  {
   "id": "b054_ev3480_0408",
   "translation": "而且明明没碰到，却感到奉莉的体温。"
  }
 ]
}