{
 "patches": [
  {
   "id": "b022_ev1170_0001",
   "translation": "……真拿琉伍学长没办法。"
  },
  {
   "id": "b022_ev1170_0017",
   "translation": "关键处被糊弄过去。"
  },
  {
   "id": "b022_ev1170_0019",
   "translation": "以奉莉为首，我接连和大家击掌。"
  },
  {
   "id": "b022_ev1170_0024",
   "translation": "「接下来公布球技大会结果！！」"
  },
  {
   "id": "b022_ev1170_0026",
   "translation": "「温泉啊啊啊！」"
  },
  {
   "id": "b022_ev1170_0029",
   "translation": "「别明知故问」"
  },
  {
   "id": "b022_ev1170_0038",
   "translation": "「特殊泳装……原来是良子小姐做的？」"
  },
  {
   "id": "b022_ev1170_0045",
   "translation": "「良子小姐做的应该没事……」"
  },
  {
   "id": "b022_ev1170_0046",
   "translation": "「啊、啊……嗯，应该没事」"
  },
  {
   "id": "b022_ev1170_0054",
   "translation": "「嗯、嗯……特、特殊泳装……应该看得出是女孩……」"
  },
  {
   "id": "b022_ev1170_0070",
   "translation": "「嘿，好，嘿！！」"
  },
  {
   "id": "b022_ev1170_0087",
   "translation": "不知不觉间，夏奏酱也混在大家中间互相击掌。"
  },
  {
   "id": "b022_ev1170_0100",
   "translation": "……这么下流，真的很抱歉。"
  },
  {
   "id": "b022_ev1170_0101",
   "translation": "……想看奉莉的脸，可胸口还是入镜，这也不行！"
  },
  {
   "id": "b022_ev1170_0102",
   "translation": "……果然是相当刺激的光景。"
  },
  {
   "id": "b022_ev1170_0107",
   "translation": "但正如她教室里所说，步梦穿泳装怎么看都是女孩。"
  },
  {
   "id": "b022_ev1170_0111",
   "translation": "不、不行。"
  },
  {
   "id": "b022_ev1170_0113",
   "translation": "比基尼是个意外的选择，但这么看真的很合适，很可爱。"
  },
  {
   "id": "b022_ev1170_0130",
   "translation": "特别是夏奏酱……超……"
  },
  {
   "id": "b022_ev1170_0140",
   "translation": "「……喜、喜欢不行吗?」"
  },
  {
   "id": "b022_ev1170_0141",
   "translation": "「……爸？是想让爸爸看？」"
  },
  {
   "id": "b022_ev1170_0167",
   "translation": "「泳装……啊?」"
  },
  {
   "id": "b022_ev1170_0171",
   "translation": "「他巡遍了所有温泉」"
  },
  {
   "id": "b022_ev1170_0201",
   "translation": "「你、你遇上的是多让人羡慕的事！？」"
  },
  {
   "id": "b022_ev1170_0202",
   "translation": "「夏、夏奏酱跑偏!」"
  },
  {
   "id": "b022_ev1170_0203",
   "translation": "「别、别说可爱!」"
  },
  {
   "id": "b022_ev1170_0204",
   "translation": "「是、是错觉吧?」"
  },
  {
   "id": "b022_ev1170_0207",
   "translation": "「可恶啊啊！为什么！为何知识之神给我试炼！？为何在这种关头……可恶，可恶！」"
  },
  {
   "id": "b022_ev1170_0210",
   "translation": "「不过……总觉得视线稍微朝陆斗那边……？」"
  },
  {
   "id": "b022_ev1170_0211",
   "translation": "「难得嘛，要是像大家一样更可爱就好了呢」"
  },
  {
   "id": "b022_ev1170_0216",
   "translation": "「就算这么说……」"
  },
  {
   "id": "b022_ev1170_0219",
   "translation": "「对对，还看到穿女式泳装的可爱真央酱」"
  },
  {
   "id": "b022_ev1170_0221",
   "translation": "「所以你看了？夏奏酱的！那对饱满巨瓜一滴不漏看了你这混蛋——！？」"
  },
  {
   "id": "b022_ev1170_0224",
   "translation": "「不、不不……」",
   "note": "ちち是違う的口吃，呼应下行"
  },
  {
   "id": "b022_ev1170_0225",
   "translation": "「等!? 章介!?」"
  },
  {
   "id": "b022_ev1170_0226",
   "translation": "「不不不，不对！哥、哥哥，奉莉酱说的是骗人的！」"
  },
  {
   "id": "b022_ev1170_0227",
   "translation": "「就是说，再讨厌女生泳装也想穿来泡温泉……」"
  },
  {
   "id": "b022_ev1170_0233",
   "translation": "「那么作为绅士，必须给淑女们提供乐趣」"
  },
  {
   "id": "b022_ev1170_0236",
   "translation": "「呃?」",
   "note": "预算紧用半角?"
  },
  {
   "id": "b022_ev1170_0240",
   "translation": "「就像刚才的陆斗，看人望过来慌张的样子很有趣哦」"
  },
  {
   "id": "b022_ev1170_0244",
   "translation": "「难道是爱上哥哥了？」"
  },
  {
   "id": "b022_ev1170_0280",
   "translation": "……嗯，就投步梦吧。"
  },
  {
   "id": "b022_ev1170_0285",
   "translation": "不过……不是因为可爱，而是因为是自己人才投她，也可以吧。"
  },
  {
   "id": "b022_ev1170_0307",
   "translation": "拜田同学虽然低调些但也可爱，真央酱换上女孩子的打扮肯定也会非常可爱……"
  },
  {
   "id": "b022_ev1170_0314",
   "translation": "「第3并列两人，所以没第4」"
  },
  {
   "id": "b022_ev1170_0316",
   "translation": "「有4人？」"
  },
  {
   "id": "b022_ev1170_0321",
   "translation": "「那么，公布第3两人。第一位，拜田希实花」"
  },
  {
   "id": "b022_ev1170_0323",
   "translation": "「前两名的人气到底有多高啊」"
  },
  {
   "id": "b022_ev1170_0326",
   "translation": "「终于轮到第1名了！」"
  },
  {
   "id": "b022_ev1170_0330",
   "translation": "「第二位茂森真央」"
  },
  {
   "id": "b022_ev1170_0333",
   "translation": "「嗯，手机没坏嘛」"
  },
  {
   "id": "b022_ev1170_0339",
   "translation": "「是事实吧？」",
   "note": ""
  },
  {
   "id": "b022_ev1170_0342",
   "translation": "「我才没叹气」"
  },
  {
   "id": "b022_ev1170_0353",
   "translation": "「又并列！」",
   "note": ""
  },
  {
   "id": "b022_ev1170_0365",
   "translation": "不过这场狂欢也将随就寝时间的到来落幕。"
  }
 ]
}