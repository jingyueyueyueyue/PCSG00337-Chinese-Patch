{
 "patches": [
  {
   "id": "b039_ev1940_0001",
   "translation": "……说起来，梦中哥哥最近怎么样了？"
  },
  {
   "id": "b039_ev1940_0004",
   "translation": "但对方不知为何中途换成了步梦……"
  },
  {
   "id": "b039_ev1940_0045",
   "translation": "喊着哥哥的梦话，好久没听到……"
  },
  {
   "id": "b039_ev1940_0050",
   "translation": "而无法释怀的感情又涌上心头……"
  },
  {
   "id": "b039_ev1940_0064",
   "translation": "一度很悬，但步梦选择了和大家一起努力。"
  },
  {
   "id": "b039_ev1940_0121",
   "translation": "「章介君！」"
  },
  {
   "id": "b039_ev1940_0143",
   "translation": "「这部分是尼龙面料，用熨斗粘的话可能会烫化……」"
  },
  {
   "id": "b039_ev1940_0160",
   "translation": "「不做会后悔嘛！」"
  },
  {
   "id": "b039_ev1940_0163",
   "translation": "到底聊什么……？"
  },
  {
   "id": "b039_ev1940_0178",
   "translation": "今天回家之后，她好像一直在频繁地收发邮件……"
  },
  {
   "id": "b039_ev1940_0192",
   "translation": "「那、那个……不是那个意思……」"
  },
  {
   "id": "b039_ev1940_0194",
   "translation": "「啊，哥哥的梦……咦？」"
  },
  {
   "id": "b039_ev1940_0216",
   "translation": "邻座的拜田同学也搭话。"
  },
  {
   "id": "b039_ev1940_0224",
   "translation": "「教室会变成工作间，恐怕待不下去」"
  },
  {
   "id": "b039_ev1940_0252",
   "translation": "「怎么了，步梦」"
  },
  {
   "id": "b039_ev1940_0276",
   "translation": "「当然。良子也商量过，实际相处我也确实感到他有这一面」"
  },
  {
   "id": "b039_ev1940_0279",
   "translation": "妈妈遗物的事虽然还堵在心头，但疙瘩很快就会变小，终会消失的吧……"
  },
  {
   "id": "b039_ev1940_0305",
   "translation": "「我回来了」"
  },
  {
   "id": "b039_ev1940_0333",
   "translation": "「是、是的。所以决定明天让步梦小姐去取」"
  }
 ]
}