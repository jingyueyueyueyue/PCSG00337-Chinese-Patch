{
 "patches": [
  {
   "id": "b004_ev0125_0001",
   "translation": "不过，那里我记得不是租的，而是要花几千万高价买下的公寓……"
  },
  {
   "id": "b004_ev0125_0008",
   "translation": "「当孩子的真是够呛。」"
  },
  {
   "id": "b004_ev0125_0016",
   "translation": "「抱歉啊，陆斗君。让你受委屈了」"
  },
  {
   "id": "b004_ev0125_0017",
   "translation": "「那么，问题是良子小姐她们到4月中旬前住哪」"
  },
  {
   "id": "b004_ev0125_0018",
   "translation": "「那良子小姐她们搬家会拖到那时候？」"
  },
  {
   "id": "b004_ev0125_0019",
   "translation": "「就是说，良子小姐和步梦君要搬到这边来？」"
  },
  {
   "id": "b004_ev0125_0034",
   "translation": "「时间也没过多久……」"
  },
  {
   "id": "b004_ev0125_0040",
   "translation": "「半月啊」"
  },
  {
   "id": "b004_ev0125_0050",
   "translation": "「知、知道了，老爸」"
  },
  {
   "id": "b004_ev0125_0055",
   "translation": "「诶——！？ 4个人住很挤吧」"
  },
  {
   "id": "b004_ev0125_0058",
   "translation": "「你这么说我就放心了。谢谢，陆斗君。步梦也快道谢」"
  },
  {
   "id": "b004_ev0125_0068",
   "translation": "「总之，你们4月初就搬来现在的家。好吗？陆斗」"
  },
  {
   "id": "b004_ev0125_0075",
   "translation": "「不过老爸好歹是新婚，还是让他和良子小姐一间房比较好……」"
  },
  {
   "id": "b004_ev0125_0083",
   "translation": "「真希望就停在『傻情侣坡』刚开始爬的阶段啊……」"
  },
  {
   "id": "b004_ev0125_0086",
   "translation": "「就是说」"
  },
  {
   "id": "b004_ev0125_0087",
   "translation": "「总、总觉得步梦的脸好像微微泛红……是错觉？」"
  },
  {
   "id": "b004_ev0125_0102",
   "translation": "「良子小姐来过很多次，但步梦是第一次来，看起来相当期待。」"
  },
  {
   "id": "b004_ev0125_0125",
   "translation": "「没问题……良子小姐，你好」"
  },
  {
   "id": "b004_ev0125_0130",
   "translation": "「不……」"
  },
  {
   "id": "b004_ev0125_0131",
   "translation": "「我说步梦君，草莓是全人类的梦」"
  },
  {
   "id": "b004_ev0125_0134",
   "translation": "「太多了，看花眼了……」"
  },
  {
   "id": "b004_ev0125_0139",
   "translation": "「诶？实在失礼了」"
  },
  {
   "id": "b004_ev0125_0140",
   "translation": "「呃，抱歉步梦」",
   "note": "预算过紧"
  },
  {
   "id": "b004_ev0125_0141",
   "translation": "「呃，那步梦君」"
  },
  {
   "id": "b004_ev0125_0158",
   "translation": "「啊，不过，说可爱对男孩子可能有点失礼……」"
  },
  {
   "id": "b004_ev0125_0159",
   "translation": "「两人似已相识，亲切地打了招呼。」"
  },
  {
   "id": "b004_ev0125_0169",
   "translation": "「不过良子小姐还没露过口风」"
  },
  {
   "id": "b004_ev0125_0172",
   "translation": "「进了客厅，良子小姐环视了一圈房间。」"
  },
  {
   "id": "b004_ev0125_0173",
   "translation": "「先去了趟客厅……」"
  },
  {
   "id": "b004_ev0125_0179",
   "translation": "「要说每个角落都干净吗，答不就是说谎了。」"
  },
  {
   "id": "b004_ev0125_0183",
   "translation": "「再和良子握手……」",
   "note": "预算过紧"
  },
  {
   "id": "b004_ev0125_0185",
   "translation": "「我投去幽怨的视线，可老爸正忙着和良子小姐亲热，根本没注意到。」"
  },
  {
   "id": "b004_ev0125_0193",
   "translation": "尤其……良子。",
   "note": "旁白行，删误加引号"
  },
  {
   "id": "b004_ev0125_0201",
   "translation": "「一进房间，良子小姐和步梦就看向了同一处。」"
  },
  {
   "id": "b004_ev0125_0204",
   "translation": "明明是男的……",
   "note": "旁白行，删误加引号"
  },
  {
   "id": "b004_ev0125_0209",
   "translation": "「……好好相处吧陆斗」",
   "note": "预算过紧"
  },
  {
   "id": "b004_ev0125_0224",
   "translation": "「我完全没事……不便的反倒是陆斗君吧？」"
  },
  {
   "id": "b004_ev0125_0232",
   "translation": "「说到底，是那栋公寓没能按期完工的错，并不是步梦君和良子小姐的错哦」"
  },
  {
   "id": "b004_ev0125_0233",
   "translation": "「我和步梦都没打算破坏陆斗君守护的东西」"
  },
  {
   "id": "b004_ev0125_0237",
   "translation": "「良子……」",
   "note": "预算过紧"
  },
  {
   "id": "b004_ev0125_0238",
   "translation": "「啊，反正都要搬了……」"
  },
  {
   "id": "b004_ev0125_0254",
   "translation": "「没那回事哦。除了打扫，陆斗君好好守护这个家，我也真切感受到了」"
  },
  {
   "id": "b004_ev0125_0260",
   "translation": "「诶？哪里？」"
  },
  {
   "id": "b004_ev0125_0262",
   "translation": "「诶？是吗？」"
  },
  {
   "id": "b004_ev0125_0263",
   "translation": "「是啊，陆斗君平时认真打扫，我看得很清楚」"
  },
  {
   "id": "b004_ev0125_0272",
   "translation": "「嗯，很懂嘛」"
  },
  {
   "id": "b004_ev0125_0282",
   "translation": "「那个，是洗场……」"
  },
  {
   "id": "b004_ev0125_0284",
   "translation": "「那，其他房间……」"
  },
  {
   "id": "b004_ev0125_0294",
   "translation": "「是、是，良子」",
   "note": "预算过紧"
  },
  {
   "id": "b004_ev0125_0332",
   "translation": "「……那明天怎么办？」"
  },
  {
   "id": "b004_ev0125_0335",
   "translation": "「那明天穿帮也行？」"
  },
  {
   "id": "b004_ev0125_0337",
   "translation": "「毕竟放榜那天，步梦要和陆斗君见面吧？」"
  },
  {
   "id": "b004_ev0125_0343",
   "translation": "「和陆斗君处得来吗？」"
  },
  {
   "id": "b004_ev0125_0344",
   "translation": "「如何？小直和陆斗君」"
  },
  {
   "id": "b004_ev0125_0345",
   "translation": "「并、并不反感哦。觉得他们是很好的人……而且，陆斗君也……」"
  },
  {
   "id": "b004_ev0125_0349",
   "translation": "「你是想，明天被陆斗君发现是女孩子，我和小直新婚就分开也没关系吗？」"
  },
  {
   "id": "b004_ev0125_0350",
   "translation": "「明天要正常穿女装出门，万一在哪儿撞见陆斗君就糟了吧……？」"
  },
  {
   "id": "b004_ev0125_0356",
   "translation": "「诶？感觉好差哦」"
  },
  {
   "id": "b004_ev0125_0366",
   "translation": "「就是说，看到陆斗君就趁早躲开……？」"
  },
  {
   "id": "b004_ev0125_0367",
   "translation": "「总之，陆斗君是把你当男孩子的，不用担心」"
  },
  {
   "id": "b004_ev0125_0371",
   "translation": "「不知道啦……信没信我是男孩还两说呢……」"
  },
  {
   "id": "b004_ev0125_0373",
   "translation": "「来到客厅，未玖开始东张西望地打量四周。」"
  },
  {
   "id": "b004_ev0125_0382",
   "translation": "「不能再做邻居这件事，也许让未玖感到超乎想象的寂寞……」"
  },
  {
   "id": "b004_ev0125_0411",
   "translation": "「叫良子小姐，是个相当有趣的人哦」"
  },
  {
   "id": "b004_ev0125_0414",
   "translation": "「在那边……可是再近……就不是邻居了……」"
  },
  {
   "id": "b004_ev0125_0419",
   "translation": "「嗯……感觉良子小姐的话，能很好地磨合着相处下去」"
  },
  {
   "id": "b004_ev0125_0436",
   "translation": "「幸好不是妹妹啊」"
  },
  {
   "id": "b004_ev0125_0438",
   "translation": "「就是恐怖片和特摄里，把鬼怪怪兽化得像真的那种妆」"
  },
  {
   "id": "b004_ev0125_0439",
   "translation": "「你看，从这往前不远在盖新公寓吧？搬去的就是那里」"
  },
  {
   "id": "b004_ev0125_0440",
   "translation": "「嘛……本来就没打算反对……而且……」"
  },
  {
   "id": "b004_ev0125_0448",
   "translation": "「不然她准会跟过来的……」"
  }
 ]
}