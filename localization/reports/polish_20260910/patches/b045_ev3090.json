{
 "patches": [
  {
   "id": "b045_ev3090_0004",
   "translation": "「三四名决赛好像结束了」"
  },
  {
   "id": "b045_ev3090_0013",
   "translation": "「啊，不过拜田同学乒乓球进半决赛！」"
  },
  {
   "id": "b045_ev3090_0034",
   "translation": "我把真央酱接起的球高高托起。"
  },
  {
   "id": "b045_ev3090_0036",
   "translation": "真央酱的鱼跃救球够到了球，球砰地弹上空中。"
  },
  {
   "id": "b045_ev3090_0094",
   "translation": "「……也看看奈奈濑的表现吧」"
  },
  {
   "id": "b045_ev3090_0102",
   "translation": "「完美嘛！」",
   "note": ""
  },
  {
   "id": "b045_ev3090_0126",
   "translation": "「接下来干嘛？」"
  },
  {
   "id": "b045_ev3090_0209",
   "translation": "「不是温泉……是洗澡……」"
  },
  {
   "id": "b045_ev3090_0256",
   "translation": "「原来是这种构造啊」"
  },
  {
   "id": "b045_ev3090_0304",
   "translation": "但从昨晚起心里的郁结一直消不散……"
  },
  {
   "id": "b045_ev3090_0333",
   "translation": "「真无聊呢」"
  },
  {
   "id": "b045_ev3090_0345",
   "translation": "「话说女生那边怎样？」"
  },
  {
   "id": "b045_ev3090_0346",
   "translation": "「哈啊……好困……」",
   "note": ""
  }
 ]
}