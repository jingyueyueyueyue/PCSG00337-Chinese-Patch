{
 "patches": [
  {
   "id": "b005_ev0155_0004",
   "translation": "不过和良子小姐她们的话，感觉能好好磨合相处下去。"
  },
  {
   "id": "b005_ev0155_0005",
   "translation": "不过不知是不是这个原因，面对良子小姐我反倒没什么先入之见。"
  },
  {
   "id": "b005_ev0155_0017",
   "translation": "连良子都没当成母亲，却只把步梦君当弟弟，老实说做不到。"
  },
  {
   "id": "b005_ev0155_0018",
   "translation": "良子小姐他们并不知道我的全部。"
  },
  {
   "id": "b005_ev0155_0019",
   "translation": "良子小姐显然没想当我母亲的意思。"
  },
  {
   "id": "b005_ev0155_0032",
   "translation": "加上步梦君和良子小姐，四人生活将从4月开始。"
  },
  {
   "id": "b005_ev0155_0034",
   "translation": "不过这点上，良子小姐的印象也比想象中好得多。"
  },
  {
   "id": "b005_ev0155_0037",
   "translation": "嘛，步梦君应该也没把我当成哥哥吧……"
  },
  {
   "id": "b005_ev0155_0054",
   "translation": "『我想那时候，我和陆斗君一定想着同样的事。』"
  },
  {
   "id": "b005_ev0155_0096",
   "translation": "「步梦君啊……名字挺像女孩呢」"
  },
  {
   "id": "b005_ev0155_0191",
   "translation": "「三谷君好像到初三前都比奉莉矮来着？」"
  },
  {
   "id": "b005_ev0155_0021",
   "translation": "「步梦……」",
   "note": "预算过紧：歩夢くん（步梦君）放不下"
  },
  {
   "id": "b005_ev0155_0057",
   "translation": "『对，陆斗也……』",
   "note": "预算过紧：陸斗くん（陆斗君）放不下"
  },
  {
   "id": "b005_ev0155_0014",
   "translation": "说没有不安是假的。"
  },
  {
   "id": "b005_ev0155_0080",
   "translation": "「那……搬家的事，能问问吗？」"
  },
  {
   "id": "b005_ev0155_0082",
   "translation": "「吓？」",
   "note": "预算8压缩（びっくり?）"
  },
  {
   "id": "b005_ev0155_0156",
   "translation": "看完错觉艺术美术馆，我们回到了附设的购物中心。"
  },
  {
   "id": "b005_ev0155_0160",
   "translation": "一发现我就消失不见，这点是肯定的……"
  },
  {
   "id": "b005_ev0155_0248",
   "translation": "不过，女孩子接连离我而去确实是事实……"
  },
  {
   "id": "b005_ev0155_0316",
   "translation": "只是有件要紧事没问成，这我知道。"
  },
  {
   "id": "b005_ev0155_0074",
   "translation": "「……是啊，外表年轻得吓人」"
  },
  {
   "id": "b005_ev0155_0098",
   "translation": "「陆斗！！早安！」"
  },
  {
   "id": "b005_ev0155_0099",
   "translation": "「啊，但绝不是装嫩。确实比实际年龄年轻」"
  },
  {
   "id": "b005_ev0155_0193",
   "translation": "「赞成——过了12点哪儿都该挤了」"
  },
  {
   "id": "b005_ev0155_0194",
   "translation": "「同感……喂，陆斗眼角都笑弯了」"
  },
  {
   "id": "b005_ev0155_0266",
   "translation": "「……不是的———————————！！」"
  },
  {
   "id": "b005_ev0155_0271",
   "translation": "「咋了？一脸呆住的表情哦？」"
  },
  {
   "id": "b005_ev0155_0299",
   "translation": "「总之不是！」",
   "note": ""
  }
 ]
}