{
 "patches": [
  {
   "id": "b088_ev5530_0001",
   "translation": "父亲似乎满意我的回答，笑得眯起眼。"
  },
  {
   "id": "b088_ev5530_0015",
   "translation": "「还有，说不是真恋爱就不被认可，也只是我的猜测，别在意」"
  },
  {
   "id": "b088_ev5530_0096",
   "translation": "「那……咦?」",
   "note": "预算过紧"
  },
  {
   "id": "b088_ev5530_0099",
   "translation": "「可你忽然不说话了……」"
  },
  {
   "id": "b088_ev5530_0101",
   "translation": "「长椅……?」",
   "note": "预算过紧"
  },
  {
   "id": "b088_ev5530_0106",
   "translation": "「那，真央酱?」",
   "note": "预算过紧"
  },
  {
   "id": "b088_ev5530_0117",
   "translation": "「不，看着超好吃！」"
  },
  {
   "id": "b088_ev5530_0127",
   "translation": "「好吃？」"
  },
  {
   "id": "b088_ev5530_0137",
   "translation": "「这样可以吗？」"
  },
  {
   "id": "b088_ev5530_0145",
   "translation": "「嗯，煎蛋卷也超好吃」"
  },
  {
   "id": "b088_ev5530_0180",
   "translation": "「缝上去？」"
  },
  {
   "id": "b088_ev5530_0221",
   "translation": "逛了快十家店，才终于找到。"
  },
  {
   "id": "b088_ev5530_0226",
   "translation": "「……不买?」",
   "note": "预算过紧"
  },
  {
   "id": "b088_ev5530_0247",
   "translation": "「嗯……这个超可爱……」"
  },
  {
   "id": "b088_ev5530_0250",
   "translation": "「诶？啊，说起来……」"
  },
  {
   "id": "b088_ev5530_0252",
   "translation": "「呃，嗯!?」",
   "note": "预算过紧"
  },
  {
   "id": "b088_ev5530_0254",
   "translation": "「可爱吧？」"
  },
  {
   "id": "b088_ev5530_0258",
   "translation": "「看啥？」"
  },
  {
   "id": "b088_ev5530_0259",
   "translation": "「呐，咦?」",
   "note": "预算过紧"
  },
  {
   "id": "b088_ev5530_0263",
   "translation": "「真是的，坦率表露心情不也挺好？」"
  },
  {
   "id": "b088_ev5530_0270",
   "translation": "到那时，吊坠什么的确实……"
  }
 ]
}