{
 "patches": [
  {
   "id": "b031_ev1610_0004",
   "translation": "为什么这么固执呢？",
   "note": "頑な（かたく）＝固执，修正误译；删ruby"
  },
  {
   "id": "b031_ev1610_0035",
   "translation": "「……那、那我就稍微休息一下啦」"
  },
  {
   "id": "b031_ev1610_0041",
   "translation": "「因、因为……难道露馅——」"
  },
  {
   "id": "b031_ev1610_0060",
   "translation": "「我接下来要跟拜田同学换班去休息。所以步梦你也马上休息」"
  },
  {
   "id": "b031_ev1610_0073",
   "translation": "「因为步梦忙，千里酱才不好意思开口」"
  },
  {
   "id": "b031_ev1610_0082",
   "translation": "「三谷君的熟人？」",
   "note": "词表：Xくん→X君"
  },
  {
   "id": "b031_ev1610_0092",
   "translation": "「啊……嘛，还行吧」",
   "note": "预算过紧"
  },
  {
   "id": "b031_ev1610_0132",
   "translation": "「这样啊谢啦」",
   "note": "预算过紧"
  },
  {
   "id": "b031_ev1610_0133",
   "translation": "「是嘛……那我告诉你件看到小步想起的事」"
  },
  {
   "id": "b031_ev1610_0138",
   "translation": "「这样啊……那接待就和步梦小姐换班吧」",
   "note": "词表：歩夢さん→步梦小姐"
  },
  {
   "id": "b031_ev1610_0159",
   "translation": "「三谷君」",
   "note": "词表：Xくん→X君"
  },
  {
   "id": "b031_ev1610_0178",
   "translation": "「差不多吧？」"
  },
  {
   "id": "b031_ev1610_0200",
   "translation": "章介的话有些地方让人摸不着头脑，但就不深究了。"
  },
  {
   "id": "b031_ev1610_0266",
   "translation": "「辛苦了三谷君」",
   "note": "词表：Xくん→X君"
  },
  {
   "id": "b031_ev1610_0298",
   "translation": "……不，还是别想这些了。",
   "note": "叙述句去引号并补句号"
  },
  {
   "id": "b031_ev1610_0318",
   "translation": "「……不愧是小直，超好吃的～」"
  },
  {
   "id": "b031_ev1610_0406",
   "translation": "那、那不妙吧……？"
  },
  {
   "id": "b031_ev1610_0413",
   "translation": "没想到爸爸居然在做晚饭。"
  }
 ]
}