{
 "patches": [
  {
   "id": "b064_ev4150_0010",
   "translation": "「嗯……终于懂了。果然还是希望三谷君想起我……」"
  },
  {
   "id": "b064_ev4150_0011",
   "translation": "「再见，真央同学。明天也请多关照」"
  },
  {
   "id": "b064_ev4150_0022",
   "translation": "颜色倒是烤成了泡芙该有的金黄色，面皮却依然扁扁的，活像块煎饼。"
  },
  {
   "id": "b064_ev4150_0068",
   "translation": "「可结果我们几乎光顾着看了对吧？」"
  },
  {
   "id": "b064_ev4150_0071",
   "translation": "「看来ｅｅｎ×ｖｉｊｆ流派的泡芙这就完成了呢，拜田同学」"
  },
  {
   "id": "b064_ev4150_0073",
   "translation": "「古德拜」",
   "note": "按词表音译统一"
  },
  {
   "id": "b064_ev4150_0088",
   "translation": "「刚才看哪里判断的？」"
  },
  {
   "id": "b064_ev4150_0113",
   "translation": "「先停下试试吧」"
  },
  {
   "id": "b064_ev4150_0118",
   "translation": "「啊，好，不好意思。那么三谷君，今天非常感谢」"
  },
  {
   "id": "b064_ev4150_0121",
   "translation": "「嗯。而且我也不忍心泼拜田冷水」"
  },
  {
   "id": "b064_ev4150_0122",
   "translation": "「哦，拜田同学喜欢的《天使之泪》啊……」"
  },
  {
   "id": "b064_ev4150_0137",
   "translation": "「嗯。太多太少都麻烦……那就大概做100个左右？」"
  },
  {
   "id": "b064_ev4150_0143",
   "translation": "「嗯，这步让步梦教你做就好。步梦也没问题吧？」"
  },
  {
   "id": "b064_ev4150_0207",
   "translation": "见拜田同学低头发抖，我放心不下，又唤了一声。"
  },
  {
   "id": "b064_ev4150_0227",
   "translation": "「拜田同学的话让大家睁大眼。」"
  },
  {
   "id": "b064_ev4150_0231",
   "translation": "「樱花祭后半战，加油啊」"
  },
  {
   "id": "b064_ev4150_0235",
   "translation": "「不过班里也许有人留着哦」"
  }
 ]
}