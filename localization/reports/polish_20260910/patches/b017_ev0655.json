{
 "patches": [
  {
   "id": "b017_ev0655_0070",
   "translation": "「你、你不会以为我乱动良子小姐内裤吧？」"
  },
  {
   "id": "b017_ev0655_0136",
   "translation": "「陆斗君，做得怎么样？」"
  },
  {
   "id": "b017_ev0655_0139",
   "translation": "「太感谢了，良子小姐」"
  },
  {
   "id": "b017_ev0655_0247",
   "translation": "「抱歉陆斗君，今天有点耽搁了……咦？」"
  },
  {
   "id": "b017_ev0655_0251",
   "translation": "「我快出门了，用完记得还给良子小姐」"
  },
  {
   "id": "b017_ev0655_0281",
   "translation": "「那，拜托良子小姐了」"
  },
  {
   "id": "b017_ev0655_0077",
   "translation": "就这么放着，步梦大概——不，肯定会拿去洗。"
  },
  {
   "id": "b017_ev0655_0117",
   "translation": "步梦对良子严格，但大概没问题……"
  },
  {
   "id": "b017_ev0655_0230",
   "translation": "大概是心意相通，良子帮我圆了场。"
  },
  {
   "id": "b017_ev0655_0287",
   "translation": "「等、等等哥哥解释一下！为什么那对妹弟变成女的了？」"
  },
  {
   "id": "b017_ev0655_0209",
   "translation": "那种状态穿着内衣，不全裸就不会露馅吧。"
  },
  {
   "id": "b017_ev0655_0324",
   "translation": "「……手干嘛？」"
  },
  {
   "id": "b017_ev0655_0093",
   "translation": "对步梦来说是亲妈的内衣。"
  },
  {
   "id": "b017_ev0655_0187",
   "translation": "不过很难想象步梦会为那种事流口水的样子。"
  },
  {
   "id": "b017_ev0655_0199",
   "translation": "步梦身上什么都没盖就睡着了。"
  },
  {
   "id": "b017_ev0655_0217",
   "translation": "话说体育课换衣服他是怎么办的？"
  },
  {
   "id": "b017_ev0655_0239",
   "translation": "未玖对着空客厅歪头不解。"
  },
  {
   "id": "b017_ev0655_0269",
   "translation": "「嗯。不用牙膏刷牙，恶心得受不了……」"
  },
  {
   "id": "b017_ev0655_0286",
   "translation": "「大概马上就能挤出来……」"
  },
  {
   "id": "b017_ev0655_0302",
   "translation": "说着，未玖拿起的是……"
  },
  {
   "id": "b017_ev0655_0036",
   "translation": "「洗衣？」"
  },
  {
   "id": "b017_ev0655_0061",
   "translation": "「诶？步梦的？」"
  },
  {
   "id": "b017_ev0655_0224",
   "translation": "总觉得……有点热……"
  },
  {
   "id": "b017_ev0655_0235",
   "translation": "未玖吓一跳。"
  },
  {
   "id": "b017_ev0655_0245",
   "translation": "「对、对不起，弄晚了」"
  },
  {
   "id": "b017_ev0655_0258",
   "translation": "「步梦还在换衣服……」"
  },
  {
   "id": "b017_ev0655_0264",
   "translation": "「哈哈……」"
  },
  {
   "id": "b017_ev0655_0265",
   "translation": "「小步……欸欸欸欸欸！？」"
  },
  {
   "id": "b017_ev0655_0272",
   "translation": "「呃……是步梦……」"
  },
  {
   "id": "b017_ev0655_0280",
   "translation": "「早啊哥哥！」"
  },
  {
   "id": "b017_ev0655_0259",
   "translation": "「良子。爸再婚的对象」",
   "note": "预算过紧"
  },
  {
   "id": "b017_ev0655_0260",
   "translation": "「良子是……婆婆？」",
   "note": "预算过紧"
  }
 ]
}