{
 "patches": [
  {
   "id": "b026_ev1340_0036",
   "translation": "「啊哈哈抱歉，可能我更恶心」"
  },
  {
   "id": "b026_ev1340_0039",
   "translation": "「不……奉莉来后，你没生气吗？」"
  },
  {
   "id": "b026_ev1340_0050",
   "translation": "「说回刚才，步梦为什么还穿着女装？」"
  },
  {
   "id": "b026_ev1340_0060",
   "translation": "「你看，我和奉莉聊初中往事时……」"
  },
  {
   "id": "b026_ev1340_0063",
   "translation": "不过……说起来……"
  },
  {
   "id": "b026_ev1340_0068",
   "translation": "「但心跳确实比刚才更快了。」"
  },
  {
   "id": "b026_ev1340_0069",
   "translation": "为什么会这样……"
  },
  {
   "id": "b026_ev1340_0080",
   "translation": "步梦满意地移开额头。"
  },
  {
   "id": "b026_ev1340_0081",
   "translation": "「平时都靠良子小姐帮忙打扮成完美女孩，步梦一人能做到什么程度呢……」"
  },
  {
   "id": "b026_ev1340_0082",
   "translation": "「爸爸上早班已经去店里了，良子小姐今天也不在家。」"
  },
  {
   "id": "b026_ev1340_0093",
   "translation": "「啊，哥哥早」"
  },
  {
   "id": "b026_ev1340_0114",
   "translation": "说着取下腋下体温计。"
  },
  {
   "id": "b026_ev1340_0120",
   "translation": "好像接了个远处的活，一大早就出门了。"
  },
  {
   "id": "b026_ev1340_0131",
   "translation": "虽然身体不会贴上，但转身时书包好像会撞到人。"
  },
  {
   "id": "b026_ev1340_0143",
   "translation": "「奉莉酱，章介君不在」"
  },
  {
   "id": "b026_ev1340_0147",
   "translation": "「啊，托福，全好了」"
  },
  {
   "id": "b026_ev1340_0201",
   "translation": "「今天也和委员们吃饭啊」"
  },
  {
   "id": "b026_ev1340_0226",
   "translation": "「很遗憾，这情报准确度非常高。五班几乎确定开女仆咖啡店」"
  },
  {
   "id": "b026_ev1340_0237",
   "translation": "「社团组？」",
   "note": ""
  },
  {
   "id": "b026_ev1340_0241",
   "translation": "「是步梦亲手做的布丁」"
  },
  {
   "id": "b026_ev1340_0268",
   "translation": "「这点上要用不显不公平的方式推进，才是成功捷径」"
  },
  {
   "id": "b026_ev1340_0281",
   "translation": "「唔……有这么好吃的？早知道我也去探病……」"
  },
  {
   "id": "b026_ev1340_0326",
   "translation": "「不觉得费事吗？」"
  },
  {
   "id": "b026_ev1340_0329",
   "translation": "「负责店面设计、运营、事务的运营组，组长是横山章介君」"
  },
  {
   "id": "b026_ev1340_0330",
   "translation": "「放学后有事绝对推不掉的人该怎么办？」"
  },
  {
   "id": "b026_ev1340_0351",
   "translation": "「嘛，洗场任务里是有人做出过遗憾的举动，但那并非有计划的……」"
  }
 ]
}