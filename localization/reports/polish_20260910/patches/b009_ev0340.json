{
 "batch": "b009_ev0340",
 "patches": [
  {
   "id": "b009_ev0340_0001",
   "translation": "我一边打着哈哈，一边再次回想表妹的长相。"
  },
  {
   "id": "b009_ev0340_0006",
   "translation": "虽然对家人这词还别扭……但不知为何……很舒服。"
  },
  {
   "id": "b009_ev0340_0021",
   "translation": "「听良子小姐说，大概是步梦的表妹……？」"
  },
  {
   "id": "b009_ev0340_0023",
   "translation": "谈妥后良子小姐继续通话。"
  },
  {
   "id": "b009_ev0340_0025",
   "translation": "「……怪人呢？」"
  },
  {
   "id": "b009_ev0340_0029",
   "translation": "「那么陆斗，能替我招待一下千里酱吗？」"
  },
  {
   "id": "b009_ev0340_0031",
   "translation": "「专业也只限西点，出了本行就跟门外汉一样」"
  },
  {
   "id": "b009_ev0340_0043",
   "translation": "「话说，看着真香啊。全是步梦君做的吗？」"
  },
  {
   "id": "b009_ev0340_0044",
   "translation": "「啊，真好吃……步梦君真是料理达人」"
  },
  {
   "id": "b009_ev0340_0053",
   "translation": "「呃……那么，为我们4人有缘组成新家庭……干杯！」"
  },
  {
   "id": "b009_ev0340_0054",
   "translation": "「呃……总之，明天就是良子的外甥或外甥女要来，对吧？」"
  },
  {
   "id": "b009_ev0340_0082",
   "translation": "我从冰箱拿出啤酒，送到还在晚酌的爸爸和良子小姐桌上。"
  },
  {
   "id": "b009_ev0340_0102",
   "translation": "「别这么客气啦，陆斗君」"
  },
  {
   "id": "b009_ev0340_0125",
   "translation": "「不、不是……没、没事……那个……」"
  },
  {
   "id": "b009_ev0340_0147",
   "translation": "「那明天……不行，步梦君的表妹要来……」"
  },
  {
   "id": "b009_ev0340_0149",
   "translation": "「真的？我也好想早点见到步梦君呢」"
  },
  {
   "id": "b009_ev0340_0160",
   "translation": "「对了，我跟步梦君提起你，他说想早点见你呢」"
  },
  {
   "id": "b009_ev0340_0168",
   "translation": "不愧是挚友……谢啦，奉莉……"
  },
  {
   "id": "b009_ev0340_0177",
   "translation": "「3年……吗……」"
  },
  {
   "id": "b009_ev0340_0185",
   "translation": "「我睡哪边都行，只是陆斗君平时睡上面吧？」"
  },
  {
   "id": "b009_ev0340_0192",
   "translation": "「像未玖酱……和陆斗……」"
  },
  {
   "id": "b009_ev0340_0195",
   "translation": "「陆斗君和未玖酱关系真好啊」"
  },
  {
   "id": "b009_ev0340_0196",
   "translation": "「陆斗才是，辛苦了」",
   "note": "预算过紧"
  },
  {
   "id": "b009_ev0340_0198",
   "translation": "「啊……呜……对，是未玖酱！」"
  },
  {
   "id": "b009_ev0340_0216",
   "translation": "「嗯……陆斗君和未玖酱就像兄妹一样……」"
  },
  {
   "id": "b009_ev0340_0220",
   "translation": "「唔……果然还是步梦君睡上铺吧」"
  },
  {
   "id": "b009_ev0340_0225",
   "translation": "『可是，陆斗君为什么讨厌新家人……？』"
  },
  {
   "id": "b009_ev0340_0226",
   "translation": "『老想着陆斗君的事，睡不着。』"
  },
  {
   "id": "b009_ev0340_0234",
   "translation": "『我和妈妈只是同住的人……陆斗君肯定这么想。』"
  },
  {
   "id": "b009_ev0340_0244",
   "translation": "「……玩伴是兄妹？」"
  },
  {
   "id": "b009_ev0340_0245",
   "translation": "「…陆斗想要弟妹吗？」"
  },
  {
   "id": "b009_ev0340_0267",
   "translation": "至少能确定，我不擅长……"
  },
  {
   "id": "b009_ev0340_0274",
   "translation": "「那个，早、早饭做好了！」"
  },
  {
   "id": "b009_ev0340_0284",
   "translation": "「嗯嗯——！」"
  },
  {
   "id": "b009_ev0340_0288",
   "translation": "偶尔睡过头没吃早饭的情况倒是有……"
  },
  {
   "id": "b009_ev0340_0289",
   "translation": "意识好像总算清醒了。"
  },
  {
   "id": "b009_ev0340_0298",
   "translation": "我家正等着步梦的表妹来做客。"
  },
  {
   "id": "b009_ev0340_0299",
   "translation": "露面的爸爸发现了住吉小姐。"
  },
  {
   "id": "b009_ev0340_0300",
   "translation": "虽然好奇，但那大概不是我能深究的事。"
  },
  {
   "id": "b009_ev0340_0305",
   "translation": "一脸笑意的住吉小姐去爸爸店里。"
  },
  {
   "id": "b009_ev0340_0321",
   "translation": "两人眼睛发亮地望着展示柜。"
  },
  {
   "id": "b009_ev0340_0322",
   "translation": "「…抱歉。好像是我搞错了」"
  },
  {
   "id": "b009_ev0340_0325",
   "translation": "「呃，怎么办？」"
  },
  {
   "id": "b009_ev0340_0327",
   "translation": "「……原来如此」"
  },
  {
   "id": "b009_ev0340_0339",
   "translation": "「那陆斗君就是哥哥了呢」"
  },
  {
   "id": "b009_ev0340_0349",
   "translation": "「哪种都行吗？」"
  },
  {
   "id": "b009_ev0340_0353",
   "translation": "「蛋糕店来着吧？」"
  },
  {
   "id": "b009_ev0340_0357",
   "translation": "「我也超级想吃！」"
  },
  {
   "id": "b009_ev0340_0380",
   "translation": "「啊……嗯……他、他是妈妈再婚对象的儿子三谷陆斗君」"
  },
  {
   "id": "b009_ev0340_0381",
   "translation": "「啊……那个……因、因为昨天陆斗君洗澡时说，可以那么叫他的……」"
  },
  {
   "id": "b009_ev0340_0382",
   "translation": "「啊，陆斗你好！老板，陆斗君他们来啦！！」"
  },
  {
   "id": "b009_ev0340_0394",
   "translation": "「不是……小步说得绕来绕去……总之是义兄妹对吧？」"
  },
  {
   "id": "b009_ev0340_0414",
   "translation": "「好————吃！！」"
  },
  {
   "id": "b009_ev0340_0415",
   "translation": "「哦，陆斗……咦？」"
  },
  {
   "id": "b009_ev0340_0432",
   "translation": "「就是这样，陆斗君别在意刚才的话」"
  },
  {
   "id": "b009_ev0340_0433",
   "translation": "「这、这什么……这么好吃的蛋糕，头回吃！！」"
  },
  {
   "id": "b009_ev0340_0441",
   "translation": "是！",
   "note": "预算5，省略引号"
  },
  {
   "id": "b009_ev0340_0444",
   "translation": "「呀，你就是千里酱吧。我是陆斗和步梦的父亲三谷直真，往后多关照」"
  },
  {
   "id": "b009_ev0340_0450",
   "translation": "离伊奈濑路口几分钟。"
  },
  {
   "id": "b009_ev0340_0452",
   "translation": "吃完午饭的午后。"
  }
 ]
}