{
 "patches": [
  {
   "id": "b037_ev1840_0001",
   "translation": "做得到吗……？",
   "note": ""
  },
  {
   "id": "b037_ev1840_0003",
   "translation": "不、不行……突然约不出口。"
  },
  {
   "id": "b037_ev1840_0025",
   "translation": "「呃，回去吧？」"
  },
  {
   "id": "b037_ev1840_0033",
   "translation": "不，得约……总不能一直和步梦这么别扭……"
  },
  {
   "id": "b037_ev1840_0052",
   "translation": "心跳骤然加速，我翻到信的背面。"
  },
  {
   "id": "b037_ev1840_0071",
   "translation": "妈妈的亲子饭……味道至今清晰……"
  },
  {
   "id": "b037_ev1840_0077",
   "translation": "「信……！？」"
  },
  {
   "id": "b037_ev1840_0085",
   "translation": "这字我记得……是妈妈的……"
  },
  {
   "id": "b037_ev1840_0100",
   "translation": "今天的谎难度好高……前辈……"
  },
  {
   "id": "b037_ev1840_0111",
   "translation": "「不，今天比平时可爱，怎么了？」"
  },
  {
   "id": "b037_ev1840_0119",
   "translation": "「我也去」",
   "note": "预算过紧，自嘲无法译出：他的“约会”其实是社团练习"
  },
  {
   "id": "b037_ev1840_0132",
   "translation": "「不，没什么……」"
  },
  {
   "id": "b037_ev1840_0138",
   "translation": "「诶，不……没事的……」"
  },
  {
   "id": "b037_ev1840_0147",
   "translation": "「那位前辈也真够执着的」"
  },
  {
   "id": "b037_ev1840_0153",
   "translation": "「哈……好期待水族馆……」"
  },
  {
   "id": "b037_ev1840_0155",
   "translation": "「呵，三个月了……好快」"
  },
  {
   "id": "b037_ev1840_0164",
   "translation": "不愧是万人迷的琉伍前辈……"
  },
  {
   "id": "b037_ev1840_0165",
   "translation": "悄悄依偎着牵着手。",
   "note": ""
  },
  {
   "id": "b037_ev1840_0173",
   "translation": "但是……幸好约她出来了。"
  },
  {
   "id": "b037_ev1840_0175",
   "translation": "为什么这么……开心呢……？"
  },
  {
   "id": "b037_ev1840_0176",
   "translation": "为什么会如此心跳加速呢？",
   "note": ""
  },
  {
   "id": "b037_ev1840_0180",
   "translation": "肩膀……手臂……手背……"
  },
  {
   "id": "b037_ev1840_0192",
   "translation": "换乘电车约30分钟。"
  },
  {
   "id": "b037_ev1840_0219",
   "translation": "「唔，是那里，水族馆」"
  },
  {
   "id": "b037_ev1840_0223",
   "translation": "「哥哥……」",
   "note": ""
  },
  {
   "id": "b037_ev1840_0262",
   "translation": "现在……不想失去她的笑容……"
  },
  {
   "id": "b037_ev1840_0273",
   "translation": "看到步梦的笑容真好。"
  },
  {
   "id": "b037_ev1840_0300",
   "translation": "「这个人叫三谷陆斗君……说他就是我的哥哥……」"
  },
  {
   "id": "b037_ev1840_0308",
   "translation": "哥哥……？",
   "note": ""
  },
  {
   "id": "b037_ev1840_0311",
   "translation": "好想就这样抱住她……"
  },
  {
   "id": "b037_ev1840_0313",
   "translation": "还是……",
   "note": ""
  },
  {
   "id": "b037_ev1840_0316",
   "translation": "身为一个女孩……"
  },
  {
   "id": "b037_ev1840_0322",
   "translation": "和步梦愉快的约会几分钟就结束。"
  },
  {
   "id": "b037_ev1840_0323",
   "translation": "感受着步梦的体温……还有呼吸……"
  },
  {
   "id": "b037_ev1840_0325",
   "translation": "牵着的手……不分开。"
  },
  {
   "id": "b037_ev1840_0354",
   "translation": "「说什么前进？是要我接受良子小姐当新妈妈？」"
  },
  {
   "id": "b037_ev1840_0361",
   "translation": "「为什么！」"
  },
  {
   "id": "b037_ev1840_0365",
   "translation": "「我的……我自己的了断……」"
  },
  {
   "id": "b037_ev1840_0369",
   "translation": "「今天就让我撒娇了个够……呢」"
  },
  {
   "id": "b037_ev1840_0370",
   "translation": "「过去和将来，我妈妈都只有一个！良子小姐不是！」"
  },
  {
   "id": "b037_ev1840_0373",
   "translation": "「我觉得，没必要强行斩断对郁美女士的感情……」"
  },
  {
   "id": "b037_ev1840_0395",
   "translation": "「嗯……那、那个……可以像未玖酱那样吗……？」"
  },
  {
   "id": "b037_ev1840_0397",
   "translation": "「呃……那就……」"
  },
  {
   "id": "b037_ev1840_0404",
   "translation": "「最、最后……那个……可以的话……」"
  },
  {
   "id": "b037_ev1840_0411",
   "translation": "「而且那句话也会伤了郁美女士啊……」"
  },
  {
   "id": "b037_ev1840_0416",
   "translation": "「家里有点事，就把店交给别人回来了」"
  }
 ]
}