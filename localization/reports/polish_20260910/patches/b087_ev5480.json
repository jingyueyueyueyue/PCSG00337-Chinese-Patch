{
 "batch": "b087_ev5480",
 "patches": [
  {
   "id": "b087_ev5480_0007",
   "translation": "（明知没有胜算，还是接下了老爷子的比试）"
  },
  {
   "id": "b087_ev5480_0009",
   "translation": "（尤其是对陆斗……）"
  },
  {
   "id": "b087_ev5480_0047",
   "translation": "「……啊，是说真央酱明显变成女孩子的方法？」"
  },
  {
   "id": "b087_ev5480_0056",
   "translation": "「别急。午休再连同真央酱一起说明」"
  },
  {
   "id": "b087_ev5480_0062",
   "translation": "「拍、拍什么？」",
   "note": ""
  },
  {
   "id": "b087_ev5480_0072",
   "translation": "「诶？啊，陆斗和真央酱果然感情很好」"
  },
  {
   "id": "b087_ev5480_0078",
   "translation": "「对、对不住，看到稀罕东西就会条件反射按快门」"
  },
  {
   "id": "b087_ev5480_0123",
   "translation": "「……女士，我当练习台如何？」"
  },
  {
   "id": "b087_ev5480_0141",
   "translation": "「除了女孩也有人能行……现在说这个无关，嗯」"
  },
  {
   "id": "b087_ev5480_0144",
   "translation": "「有你在呢」",
   "note": "存疑：「いる」主语两可，按真央续句「有你在」处理"
  },
  {
   "id": "b087_ev5480_0156",
   "translation": "「就、就算这么说……我……恋爱……」"
  },
  {
   "id": "b087_ev5480_0207",
   "translation": "「其实，男装和内衣全被老爷子没收了，所以得去买女装……嗯……」",
   "note": "原文末「あるの……」为迟疑尾音，按语气并入"
  },
  {
   "id": "b087_ev5480_0209",
   "translation": "「真央酱，提个要求好吗」"
  },
  {
   "id": "b087_ev5480_0212",
   "translation": "「两人好好想，把恋人该做的事一件件做就好」"
  },
  {
   "id": "b087_ev5480_0294",
   "translation": "「如、如何……？」",
   "note": ""
  },
  {
   "id": "b087_ev5480_0300",
   "translation": "「我更喜欢现在这件？」"
  }
 ]
}