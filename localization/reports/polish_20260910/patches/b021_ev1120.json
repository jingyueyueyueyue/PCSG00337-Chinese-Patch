{
 "patches": [
  {
   "id": "b021_ev1120_0056",
   "translation": "只不过是把守门员的长传一碰，碰巧滚进了球门而已。"
  },
  {
   "id": "b021_ev1120_0097",
   "translation": "「这个嘛……我不太起眼……」"
  },
  {
   "id": "b021_ev1120_0121",
   "translation": "被误判动摇的两人反而丢了第二局，第三局章介看起来是体力不支了。"
  },
  {
   "id": "b021_ev1120_0126",
   "translation": "对方队伍里打过篮球的好像很多，我们陷入苦战。"
  },
  {
   "id": "b021_ev1120_0136",
   "translation": "「……信过你」"
  },
  {
   "id": "b021_ev1120_0141",
   "translation": "「这么说，就看我们了，说不定还不错？」"
  },
  {
   "id": "b021_ev1120_0157",
   "translation": "「怪章介君？」"
  },
  {
   "id": "b021_ev1120_0172",
   "translation": "「总、总算是前四……」"
  },
  {
   "id": "b021_ev1120_0176",
   "translation": "「不用道歉啦……话说你怎么过来了？你自己的比赛呢？」"
  },
  {
   "id": "b021_ev1120_0185",
   "translation": "「果然好难……」"
  },
  {
   "id": "b021_ev1120_0208",
   "translation": "可是练了之后，比赛虽然一开始失利，表现却渐渐变好……"
  },
  {
   "id": "b021_ev1120_0220",
   "translation": "用我教的脚内侧踢法把球传给奉莉。"
  },
  {
   "id": "b021_ev1120_0232",
   "translation": "一时冲动报了五人制足球，之后又担心得不行，怕打不好……"
  },
  {
   "id": "b021_ev1120_0254",
   "translation": "「咋回事？」"
  },
  {
   "id": "b021_ev1120_0259",
   "translation": "「传球……往门里传！」"
  },
  {
   "id": "b021_ev1120_0261",
   "translation": "「温泉、温泉……」"
  },
  {
   "id": "b021_ev1120_0283",
   "translation": "「嗯！」"
  },
  {
   "id": "b021_ev1120_0301",
   "translation": "「知道！」"
  },
  {
   "id": "b021_ev1120_0320",
   "translation": "如有神助地一记挥拳，击出了瞄向右上角的近距离射门。"
  },
  {
   "id": "b021_ev1120_0324",
   "translation": "步梦用力地抱住了我。"
  },
  {
   "id": "b021_ev1120_0344",
   "translation": "「三谷君，好厉害，真的……我……呜呜……」"
  },
  {
   "id": "b021_ev1120_0358",
   "translation": "「拜田同学，别哭啦」"
  },
  {
   "id": "b021_ev1120_0366",
   "translation": "平局收场就进点球大战。"
  }
 ]
}