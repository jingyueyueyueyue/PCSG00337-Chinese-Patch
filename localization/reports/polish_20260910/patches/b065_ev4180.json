{
 "patches": [
  {
   "id": "b065_ev4180_0033",
   "translation": "「如果错失慈善义卖会的优胜，樱花祭的综合优胜就会越发遥远」"
  },
  {
   "id": "b065_ev4180_0098",
   "translation": "不知所措，两人一起僵住。"
  },
  {
   "id": "b065_ev4180_0112",
   "translation": "「我也觉得，从客人立场能被接待更久，那样不是更开心吗……」"
  },
  {
   "id": "b065_ev4180_0159",
   "translation": "于是，我和拜田同学走向了料理组那边。"
  },
  {
   "id": "b065_ev4180_0160",
   "translation": "我猛然回神，还失态地喊出了声。"
  },
  {
   "id": "b065_ev4180_0161",
   "translation": "确认完毕的我和拜田同学，一边感受着微妙的气氛，一边为了拿草莓前往ｅｅｎ×ｖｉｊｆ。"
  },
  {
   "id": "b065_ev4180_0187",
   "translation": "「……总之，顺利决定改成制服咖啡店，真是太好了」"
  },
  {
   "id": "b065_ev4180_0201",
   "translation": "「道理上都明白……可就是想快点出结果，怎么也……」"
  },
  {
   "id": "b065_ev4180_0209",
   "translation": "「嗯，是没错……」"
  },
  {
   "id": "b065_ev4180_0210",
   "translation": "「抱歉。呃――」"
  },
  {
   "id": "b065_ev4180_0217",
   "translation": "「不……我要说。我的初中是光叶女子学园」"
  },
  {
   "id": "b065_ev4180_0226",
   "translation": "「抱歉，是不是问到不该问的？」"
  },
  {
   "id": "b065_ev4180_0228",
   "translation": "「诶？拜田说什么？」",
   "note": "预算紧压缩（拜田同学→拜田）"
  },
  {
   "id": "b065_ev4180_0231",
   "translation": "「工作中打扰很抱歉」"
  },
  {
   "id": "b065_ev4180_0238",
   "translation": "「是吗？总之先进来歇着吧」"
  },
  {
   "id": "b065_ev4180_0239",
   "translation": "「对。能写张收据吗？」"
  },
  {
   "id": "b065_ev4180_0243",
   "translation": "「回来啦！回来晚了抱歉」"
  },
  {
   "id": "b065_ev4180_0246",
   "translation": "「话说今天能做的也就是去草莓蒂、泡进细砂糖为止，很快就做完」"
  },
  {
   "id": "b065_ev4180_0255",
   "translation": "「嗯？慈善义卖会的传单啊……」"
  }
 ]
}