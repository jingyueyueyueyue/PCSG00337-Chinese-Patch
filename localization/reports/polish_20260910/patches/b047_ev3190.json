{
 "patches": [
  {
   "id": "b047_ev3190_0014",
   "translation": "「1年8班，获得210分，是第3名！」"
  },
  {
   "id": "b047_ev3190_0015",
   "translation": "「这可不是随便能做到的，三谷兄真的很重视伙伴」"
  },
  {
   "id": "b047_ev3190_0018",
   "translation": "「我扭到脚的话也拜托你」"
  },
  {
   "id": "b047_ev3190_0042",
   "translation": "「只是可惜，冠军没戏了吧」"
  },
  {
   "id": "b047_ev3190_0059",
   "translation": "「可是，为什么敢断言那么遥远的未来……？」"
  },
  {
   "id": "b047_ev3190_0060",
   "translation": "「不过，看起来那样，是因为篝火的火光吧……？」"
  },
  {
   "id": "b047_ev3190_0073",
   "translation": "「……可奉莉到时还没结婚……？」"
  },
  {
   "id": "b047_ev3190_0086",
   "translation": "「再说，聊孩子还早，连有没有人愿意跟我结婚都不知道……」"
  },
  {
   "id": "b047_ev3190_0087",
   "translation": "「所以……到现在想法没变吗？」"
  },
  {
   "id": "b047_ev3190_0099",
   "translation": "「魔芋丝反正不会有吧……」"
  },
  {
   "id": "b047_ev3190_0103",
   "translation": "「在吃呢」"
  },
  {
   "id": "b047_ev3190_0106",
   "translation": "「不是火锅大王是烧烤奉行吗……」"
  },
  {
   "id": "b047_ev3190_0108",
   "translation": "「都说要保证了，没办法，我负责哦」"
  },
  {
   "id": "b047_ev3190_0187",
   "translation": "住宿研修第二天的晚上，和昨天一样，在被查寝老师提醒几次后大家也自然入睡了。"
  },
  {
   "id": "b047_ev3190_0198",
   "translation": "而且我知道，这话还有后续……"
  },
  {
   "id": "b047_ev3190_0199",
   "translation": "是因为今天的事？"
  },
  {
   "id": "b047_ev3190_0200",
   "translation": "大概是因为从没想过和奉莉交往吧……"
  },
  {
   "id": "b047_ev3190_0202",
   "translation": "也就是说，到那岁数前两人不可能交往。"
  },
  {
   "id": "b047_ev3190_0203",
   "translation": "难道说，现在的我其实有想和奉莉交往的心情？"
  },
  {
   "id": "b047_ev3190_0209",
   "translation": "住宿研修最终日——"
  },
  {
   "id": "b047_ev3190_0220",
   "translation": "「怎么了？眼睛有点红吧？没睡好？」"
  },
  {
   "id": "b047_ev3190_0233",
   "translation": "「是没错啦……！」"
  },
  {
   "id": "b047_ev3190_0256",
   "translation": "步梦小姐也辛苦了",
   "note": "预算紧省略「」"
  }
 ]
}