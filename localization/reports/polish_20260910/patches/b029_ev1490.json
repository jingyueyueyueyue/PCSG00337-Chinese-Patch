{
 "patches": [
  {
   "id": "b029_ev1490_0008",
   "translation": "对女孩步梦来说，身边最近的憧憬异性……"
  },
  {
   "id": "b029_ev1490_0025",
   "translation": "「总觉得你从刚才就在笑……」"
  },
  {
   "id": "b029_ev1490_0046",
   "translation": "听说因为要去办公寓的签约手续，今天店里交给了主厨。"
  },
  {
   "id": "b029_ev1490_0085",
   "translation": "「良子。玩笑开得太过分了吧? 步梦君很困扰」"
  },
  {
   "id": "b029_ev1490_0161",
   "translation": "「这就去!」"
  },
  {
   "id": "b029_ev1490_0178",
   "translation": "「嗯，谢谢。那我回料理室去啦」"
  },
  {
   "id": "b029_ev1490_0236",
   "translation": "「三谷妹，我来拿」"
  },
  {
   "id": "b029_ev1490_0240",
   "translation": "「声音太小啦! 再来一遍!」"
  },
  {
   "id": "b029_ev1490_0271",
   "translation": "「好的，哥哥」"
  },
  {
   "id": "b029_ev1490_0285",
   "translation": "「但是陆斗，你其实没觉得多困扰吧?」"
  },
  {
   "id": "b029_ev1490_0293",
   "translation": "「哪有什么遗憾……」"
  },
  {
   "id": "b029_ev1490_0305",
   "translation": "「嗯，真是这么想」"
  },
  {
   "id": "b029_ev1490_0313",
   "translation": "「陆斗的『妹妹』真勤快呢」"
  },
  {
   "id": "b029_ev1490_0327",
   "translation": "难道说奉莉一开始就知道步梦是女孩……?"
  },
  {
   "id": "b029_ev1490_0360",
   "translation": "「良子……这种事别跟孩子说」"
  },
  {
   "id": "b029_ev1490_0366",
   "translation": "「拜托冷静点陆斗君」"
  },
  {
   "id": "b029_ev1490_0374",
   "translation": "「不，不是的——」",
   "note": "预算所限：保留否认与截断语气，省称呼"
  },
  {
   "id": "b029_ev1490_0380",
   "translation": "「我明白。但我觉得该对陆斗君和盘托出……特别是钱的事……」"
  },
  {
   "id": "b029_ev1490_0383",
   "translation": "在这里生活下去……也就是要和步梦继续同屋……?",
   "note": "原译超宽，压缩措辞并补出「在这里」"
  }
 ]
}