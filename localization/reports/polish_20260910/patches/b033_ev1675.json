{
 "patches": [
  {
   "id": "b033_ev1675_0001",
   "translation": "不过主要聊的是良子小姐，被嘱咐保密，我不能说。"
  },
  {
   "id": "b033_ev1675_0005",
   "translation": "瞬间，良子小姐对我微笑之后——"
  },
  {
   "id": "b033_ev1675_0007",
   "translation": "对了个眼神。"
  },
  {
   "id": "b033_ev1675_0011",
   "translation": "「不过……今天真是不错的假日呢」"
  },
  {
   "id": "b033_ev1675_0026",
   "translation": "「嗯，陆斗往事」"
  },
  {
   "id": "b033_ev1675_0032",
   "translation": "「呵呵。小直自己也一样，能和步梦单独说话很开心吧？」"
  },
  {
   "id": "b033_ev1675_0043",
   "translation": "「陆斗也」",
   "note": "预算过紧"
  },
  {
   "id": "b033_ev1675_0045",
   "translation": "「是呢。能和陆斗君单独说话，我很开心呢」"
  },
  {
   "id": "b033_ev1675_0048",
   "translation": "「等、等下别擅自讲……」"
  },
  {
   "id": "b033_ev1675_0052",
   "translation": "「呐陆斗君，那件事是我俩的秘密哟？」"
  },
  {
   "id": "b033_ev1675_0053",
   "translation": "「是良子」",
   "note": "预算过紧"
  },
  {
   "id": "b033_ev1675_0058",
   "translation": "「嗯？有让步梦君为难的话题吗？」"
  },
  {
   "id": "b033_ev1675_0060",
   "translation": "唔，我觉得两人都不需要……"
  },
  {
   "id": "b033_ev1675_0063",
   "translation": "突然和良子小姐对上眼。"
  },
  {
   "id": "b033_ev1675_0064",
   "translation": "不由点了头。"
  },
  {
   "id": "b033_ev1675_0077",
   "translation": "『听到这话我哭了。』"
  },
  {
   "id": "b033_ev1675_0078",
   "translation": "『我想说我是女孩子……。』"
  },
  {
   "id": "b033_ev1675_0079",
   "translation": "『我想说我是妹妹……』"
  },
  {
   "id": "b033_ev1675_0082",
   "translation": "那样的话，顺势接受就好了。"
  },
  {
   "id": "b033_ev1675_0086",
   "translation": "紧贴着我，步梦眯起了眼睛。"
  },
  {
   "id": "b033_ev1675_0087",
   "translation": "回神时，步梦已是把我压倒在被子上的姿势。"
  },
  {
   "id": "b033_ev1675_0095",
   "translation": "步梦脸红了。"
  },
  {
   "id": "b033_ev1675_0097",
   "translation": "「没、没事吧？步梦？」"
  },
  {
   "id": "b033_ev1675_0111",
   "translation": "一觉醒来，真正的哥哥就在身边……总觉得很像梦……"
  },
  {
   "id": "b033_ev1675_0112",
   "translation": "「才不是梦哦」"
  },
  {
   "id": "b033_ev1675_0117",
   "translation": "「啊……你醒了？」"
  },
  {
   "id": "b033_ev1675_0121",
   "translation": "「啊啊！？」"
  },
  {
   "id": "b033_ev1675_0122",
   "translation": "「良子的秘密道具」",
   "note": "预算过紧"
  },
  {
   "id": "b033_ev1675_0154",
   "translation": "回过头来。"
  },
  {
   "id": "b033_ev1675_0157",
   "translation": "对，家务分担……"
  },
  {
   "id": "b033_ev1675_0164",
   "translation": "说起来，步梦还不肯下来。"
  },
  {
   "id": "b033_ev1675_0167",
   "translation": "什么都不做，只看妹妹安稳睡姿——"
  },
  {
   "id": "b033_ev1675_0176",
   "translation": "被打了个措手不及，我们困惑地向学长点头。"
  },
  {
   "id": "b033_ev1675_0200",
   "translation": "入学准备说明会时，我记得琉伍学长说过这话"
  },
  {
   "id": "b033_ev1675_0203",
   "translation": "「琉伍学长，久等了」"
  },
  {
   "id": "b033_ev1675_0224",
   "translation": "「那、那最后是什么？」"
  },
  {
   "id": "b033_ev1675_0234",
   "translation": "我隐约觉得，那只是因为选舞蹈和合唱的班本来就多……"
  },
  {
   "id": "b033_ev1675_0240",
   "translation": "「话说女生们今天好可爱啊」"
  },
  {
   "id": "b033_ev1675_0242",
   "translation": "「首先话剧太长。剧本不够有趣，中途绝对会腻」"
  },
  {
   "id": "b033_ev1675_0243",
   "translation": "「嗯，正如陆斗所说。实际上去年跳舞的班有3个，合唱的有2个」"
  },
  {
   "id": "b033_ev1675_0246",
   "translation": "「谢谢奉莉和大家」",
   "note": "预算过紧"
  },
  {
   "id": "b033_ev1675_0252",
   "translation": "想起了早晨。"
  },
  {
   "id": "b033_ev1675_0256",
   "translation": "「果然，我当不成步梦的『哥哥』吗……？」"
  },
  {
   "id": "b033_ev1675_0258",
   "translation": "「昨天的话是骗我的吗？」"
  },
  {
   "id": "b033_ev1675_0270",
   "translation": "「一个人扛事什么的……没那么夸张吧……」"
  },
  {
   "id": "b033_ev1675_0271",
   "translation": "「分家务」",
   "note": "预算过紧"
  },
  {
   "id": "b033_ev1675_0272",
   "translation": "「家务分担」"
  },
  {
   "id": "b033_ev1675_0276",
   "translation": "良子小姐昨天也讲了类似的话。担心步梦会不会撑不住。"
  },
  {
   "id": "b033_ev1675_0281",
   "translation": "「嗯。我这样，良子小姐这样，千里酱也——」"
  },
  {
   "id": "b033_ev1675_0285",
   "translation": "「那、那个，擦鞋？」"
  },
  {
   "id": "b033_ev1675_0293",
   "translation": "「还有……洗碗趁做饭顺便做，我来就行……而且打扫也没那么费事……」"
  },
  {
   "id": "b033_ev1675_0307",
   "translation": "这扇门当然不会轻易全开，但就一点点稳步来吧。"
  },
  {
   "id": "b033_ev1675_0312",
   "translation": "可是，为什么求良子小姐做饭来着……？"
  },
  {
   "id": "b033_ev1675_0314",
   "translation": "可我现在拜托了良子小姐……"
  },
  {
   "id": "b033_ev1675_0315",
   "translation": "想起和我分了家务，步梦生硬地点了点头。"
  },
  {
   "id": "b033_ev1675_0317",
   "translation": "良子小姐开心地低语，把视线投向步梦。"
  },
  {
   "id": "b033_ev1675_0318",
   "translation": "说是修行一环，让步梦在家也过女孩子的生活。"
  },
  {
   "id": "b033_ev1675_0320",
   "translation": "瞬间浮现的，是妈妈常做的铺着海苔丝、蛋又软又滑的亲子饭。"
  },
  {
   "id": "b033_ev1675_0325",
   "translation": "爸爸和良子小姐到家后不久就开饭了。"
  },
  {
   "id": "b033_ev1675_0326",
   "translation": "得知步梦头发的事后，是良子小姐提议的。"
  },
  {
   "id": "b033_ev1675_0327",
   "translation": "步梦不是会过意不去，不肯没理由让良子小姐做饭吗？"
  },
  {
   "id": "b033_ev1675_0328",
   "translation": "步梦羞怯地点了头。"
  },
  {
   "id": "b033_ev1675_0337",
   "translation": "「那我近期就做。陆斗君想吃什么？」"
  },
  {
   "id": "b033_ev1675_0338",
   "translation": "「下个轮陆斗君了？」"
  },
  {
   "id": "b033_ev1675_0343",
   "translation": "「陆斗怎么干起活了？」"
  },
  {
   "id": "b033_ev1675_0351",
   "translation": "「是你儿子吧」",
   "note": "预算过紧"
  },
  {
   "id": "b033_ev1675_0353",
   "translation": "「步梦和陆斗君也处得很好，真是太好了」"
  },
  {
   "id": "b033_ev1675_0362",
   "translation": "「嗯，最喜欢了。谢谢你，步梦君」"
  },
  {
   "id": "b033_ev1675_0364",
   "translation": "「谢谢步梦君。那我马上提一个要求行吗？」"
  },
  {
   "id": "b033_ev1675_0365",
   "translation": "「不，可是……还是交给良子小姐吧。不知道会做出什么才更有乐趣」"
  },
  {
   "id": "b033_ev1675_0374",
   "translation": "「知道了，妈妈」"
  },
  {
   "id": "b033_ev1675_0396",
   "translation": "「是真的，良子小姐」"
  },
  {
   "id": "b033_ev1675_0398",
   "translation": "「你看，最近步梦和陆斗也聊得很热络，就像只有我被疏远了一样……」"
  },
  {
   "id": "b033_ev1675_0406",
   "translation": "没错，如良子小姐所说，步梦在家也要扮女孩了。"
  },
  {
   "id": "b033_ev1675_0410",
   "translation": "点头后，步梦神情有些落寞。"
  }
 ]
}