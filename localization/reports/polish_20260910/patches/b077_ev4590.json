{
 "patches": [
  {
   "id": "b077_ev4590_0014",
   "translation": "希实花吸了口气，轻轻一笑。"
  },
  {
   "id": "b077_ev4590_0029",
   "translation": "「……换个话题。那之后如何？」"
  },
  {
   "id": "b077_ev4590_0035",
   "translation": "「抱歉。靠自己只能想到这了。当时的真相，能告诉我吗？」"
  },
  {
   "id": "b077_ev4590_0053",
   "translation": "「放学后，被笑话是朴实花，我哭了，陆斗君牵起我的手，带我去了某个地方」"
  },
  {
   "id": "b077_ev4590_0059",
   "translation": "「那之后，有想起往事吗？」"
  },
  {
   "id": "b077_ev4590_0060",
   "translation": "「不想让你失望就直说，我还没全部想起来」"
  },
  {
   "id": "b077_ev4590_0144",
   "translation": "为了脱裤子而往身上裹毛巾时，我猛然一惊。"
  },
  {
   "id": "b077_ev4590_0205",
   "translation": "我垫起的球，被真央酱托球送上半空。"
  },
  {
   "id": "b077_ev4590_0224",
   "translation": "我也放心了",
   "note": "预算紧，省略引号"
  },
  {
   "id": "b077_ev4590_0226",
   "translation": "「胜点虽少，也要稳稳为班级出力！」"
  },
  {
   "id": "b077_ev4590_0264",
   "translation": "真央酱虽然失去平衡仍追上球，救了起来。"
  }
 ]
}