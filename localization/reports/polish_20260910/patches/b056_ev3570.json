{
 "patches": [
  {
   "id": "b056_ev3570_0054",
   "translation": "说是到家了，别担心……"
  },
  {
   "id": "b056_ev3570_0127",
   "translation": "「她现在好像烦恼不少」"
  },
  {
   "id": "b056_ev3570_0129",
   "translation": "「三谷君，辛苦了」",
   "note": "三谷くん按词表译三谷君"
  },
  {
   "id": "b056_ev3570_0141",
   "translation": "「啊、嗯……刚见到奉莉阿姨了」"
  },
  {
   "id": "b056_ev3570_0152",
   "translation": "「那个……您知道奉莉同学现在人在哪吗？」",
   "note": "奉莉さん按称呼规则补同学"
  },
  {
   "id": "b056_ev3570_0183",
   "translation": "总之，先从家门口走开。"
  },
  {
   "id": "b056_ev3570_0204",
   "translation": "「……这话别再说了」",
   "note": "初翻与_0205译文错位，已校正"
  },
  {
   "id": "b056_ev3570_0205",
   "translation": "「原来如此」",
   "note": "预算紧，省略号省略"
  },
  {
   "id": "b056_ev3570_0227",
   "translation": "「我还是想知道她的烦恼」"
  },
  {
   "id": "b056_ev3570_0311",
   "translation": "（不由得心动了一下）"
  },
  {
   "id": "b056_ev3570_0320",
   "translation": "（要是说出这副身体……）"
  }
 ]
}