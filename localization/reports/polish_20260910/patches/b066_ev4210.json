{
 "patches": [
  {
   "id": "b066_ev4210_0071",
   "translation": "「取消女仆装的事，三谷君的妈妈没有生气吗？」"
  },
  {
   "id": "b066_ev4210_0093",
   "translation": "「所以是被原谅了吗？」"
  },
  {
   "id": "b066_ev4210_0112",
   "translation": "「……最后那句让人很在意，现在先别吐槽了」"
  },
  {
   "id": "b066_ev4210_0116",
   "translation": "「那要不要提提『高藤咖啡』『高藤松饼』之类的？」"
  },
  {
   "id": "b066_ev4210_0124",
   "translation": "早上我已经确认过班上大家各能带来什么制服了——"
  },
  {
   "id": "b066_ev4210_0141",
   "translation": "「——之后，果酱装罐完毕。」"
  },
  {
   "id": "b066_ev4210_0160",
   "translation": "「细砂糖渐渐溶化了呢」"
  },
  {
   "id": "b066_ev4210_0183",
   "translation": "「那个……三谷君果然在和奉莉小姐交往吗……？」"
  },
  {
   "id": "b066_ev4210_0184",
   "translation": "「回见啦」"
  },
  {
   "id": "b066_ev4210_0197",
   "translation": "而老爸他——"
  },
  {
   "id": "b066_ev4210_0243",
   "translation": "「嗯，很有祭日将近氛围」"
  },
  {
   "id": "b066_ev4210_0264",
   "translation": "「听说用店里的烤箱，2个小时左右就能烤100个，准备工作应该能从容完成」"
  },
  {
   "id": "b066_ev4210_0274",
   "translation": "「那个……托、托大家的福，各项准备都顺利完成，今天就先到这里」"
  },
  {
   "id": "b066_ev4210_0278",
   "translation": "「是嘛？我们正好做完准备，正在回来的路上」"
  },
  {
   "id": "b066_ev4210_0279",
   "translation": "「步梦小姐她们也刚好做完准备」"
  }
 ]
}