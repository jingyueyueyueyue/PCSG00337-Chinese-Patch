{
 "patches": [
  {
   "id": "b082_ev5270_0014",
   "translation": "「……是，是贴太近了吧？」"
  },
  {
   "id": "b082_ev5270_0035",
   "translation": "「初中毕业远足时没时间坐上，这次绝对要坐那个！」"
  },
  {
   "id": "b082_ev5270_0039",
   "translation": "「害怕的话看前面，那样和普通摩天轮差不多」",
   "note": "原译超宽，压缩措辞"
  },
  {
   "id": "b082_ev5270_0087",
   "translation": "「是、是……吸——呼——吸——呼——……」"
  },
  {
   "id": "b082_ev5270_0093",
   "translation": "咿",
   "note": "预算≤5，省略「」"
  },
  {
   "id": "b082_ev5270_0136",
   "translation": "「好像特别喜欢步梦小姐的便当呢」"
  },
  {
   "id": "b082_ev5270_0146",
   "translation": "「这次轮到我们下车了呢」"
  },
  {
   "id": "b082_ev5270_0155",
   "translation": "然后，下车时——"
  },
  {
   "id": "b082_ev5270_0176",
   "translation": "（不……问不出口）"
  },
  {
   "id": "b082_ev5270_0178",
   "translation": "（真的很感谢让我意识到这点的陆斗）"
  },
  {
   "id": "b082_ev5270_0191",
   "translation": "「……怎么了，真央酱」"
  },
  {
   "id": "b082_ev5270_0192",
   "translation": "「女仆咖啡店……行吗？」"
  },
  {
   "id": "b082_ev5270_0197",
   "translation": "「夺冠的话樱花祭就单独第一」",
   "note": "原译超宽，压缩措辞"
  },
  {
   "id": "b082_ev5270_0235",
   "translation": "「真央酱是为陆斗才肯做的，没发现？」"
  },
  {
   "id": "b082_ev5270_0251",
   "translation": "「说错什么了」"
  },
  {
   "id": "b082_ev5270_0261",
   "translation": "不过结果好，就这样吧。"
  }
 ]
}