{
 "patches": [
  {
   "id": "b002_ev0040_0002",
   "translation": "（……是那样吗？没错……）"
  },
  {
   "id": "b002_ev0040_0014",
   "translation": "「呼」"
  },
  {
   "id": "b002_ev0040_0060",
   "translation": "「2号站台，即将关门」"
  },
  {
   "id": "b002_ev0040_0064",
   "translation": "「所以说，无法想象和陆斗不在一个班」"
  },
  {
   "id": "b002_ev0040_0071",
   "translation": "「真的～?」"
  },
  {
   "id": "b002_ev0040_0075",
   "translation": "「观光啊」"
  },
  {
   "id": "b002_ev0040_0088",
   "translation": "「嗯……搞不懂啦」"
  },
  {
   "id": "b002_ev0040_0118",
   "translation": "「即将到站，福留站，右侧出口……」"
  },
  {
   "id": "b002_ev0040_0119",
   "translation": "「不嫌弃就用这个」"
  },
  {
   "id": "b002_ev0040_0142",
   "translation": "（……当然。他哪会记得我这种人）"
  },
  {
   "id": "b002_ev0040_0144",
   "translation": "（可是，三谷君没注意到我……）"
  },
  {
   "id": "b002_ev0040_0147",
   "translation": "（别说哭的理由，连为手帕道谢都……）"
  },
  {
   "id": "b002_ev0040_0151",
   "translation": "（以前虽然也很帅……）"
  },
  {
   "id": "b002_ev0040_0154",
   "translation": "（再说，三谷君要来朝冈的话，他忘了我反而更方便……）"
  },
  {
   "id": "b002_ev0040_0155",
   "translation": "（果然是三谷君，没错……）"
  },
  {
   "id": "b002_ev0040_0156",
   "translation": "（这份温柔……没变啊……）"
  },
  {
   "id": "b002_ev0040_0164",
   "translation": "朝挥着手远去的奉莉，我也用力挥手回应。"
  },
  {
   "id": "b002_ev0040_0180",
   "translation": "「哪里？」"
  },
  {
   "id": "b002_ev0040_0181",
   "translation": "「是不是很怪？」"
  },
  {
   "id": "b002_ev0040_0183",
   "translation": "共鸣？"
  },
  {
   "id": "b002_ev0040_0186",
   "translation": "不觉得",
   "note": "预算过紧，省略引号"
  },
  {
   "id": "b002_ev0040_0190",
   "translation": "「电车上有个女孩哭了吧?」"
  },
  {
   "id": "b002_ev0040_0192",
   "translation": "「奉莉你也考上了，恭喜你。今后也照旧请多关照」"
  },
  {
   "id": "b002_ev0040_0199",
   "translation": "「有有有有，大大地有。那孩子要的是能共鸣的人」"
  },
  {
   "id": "b002_ev0040_0216",
   "translation": "「不好意思——工程车要通过，请稍等片刻」"
  },
  {
   "id": "b002_ev0040_0231",
   "translation": "但那笑容，从六年前起就丝毫未变……"
  },
  {
   "id": "b002_ev0040_0272",
   "translation": "紧握住挂在腰间的表。"
  },
  {
   "id": "b002_ev0040_0289",
   "translation": "借此契机，静下心神。"
  },
  {
   "id": "b002_ev0040_0292",
   "translation": "「……那，是怎样的人?」"
  },
  {
   "id": "b002_ev0040_0293",
   "translation": "「3月……」"
  },
  {
   "id": "b002_ev0040_0302",
   "translation": "「冷笑话？」"
  },
  {
   "id": "b002_ev0040_0307",
   "translation": "「要我接?」"
  },
  {
   "id": "b002_ev0040_0318",
   "translation": "「啊，嗯……抱歉」"
  },
  {
   "id": "b002_ev0040_0319",
   "translation": "「哦，回来得正好?」"
  },
  {
   "id": "b002_ev0040_0327",
   "translation": "「为什么?」"
  },
  {
   "id": "b002_ev0040_0331",
   "translation": "「再婚？那个再婚?」"
  },
  {
   "id": "b002_ev0040_0338",
   "translation": "回来啦"
  },
  {
   "id": "b002_ev0040_0358",
   "translation": "再婚呐……"
  },
  {
   "id": "b002_ev0040_0384",
   "translation": "明明至少今天，想忘掉一切享受考上的余韵……"
  },
  {
   "id": "b002_ev0040_0402",
   "translation": "「一见钟情」"
  },
  {
   "id": "b002_ev0040_0407",
   "translation": "「……愿那女孩有好事发生」"
  },
  {
   "id": "b002_ev0040_0415",
   "translation": "嗯，硬撑也要高兴起来！"
  }
 ]
}