{
 "patches": [
  {
   "id": "b043_ev2220_0002",
   "translation": "……完全不差嘛。",
   "note": "全然ダメじゃない为双重否定，译作不差"
  },
  {
   "id": "b043_ev2220_0009",
   "translation": "不过，我俩的关系已正式告诉奉莉了。"
  },
  {
   "id": "b043_ev2220_0015",
   "translation": "确实如此……"
  },
  {
   "id": "b043_ev2220_0080",
   "translation": "「因为……梦中哥哥，是我的初恋嘛」"
  },
  {
   "id": "b043_ev2220_0088",
   "translation": "「可是，才住了一个月左右……好神奇……」"
  },
  {
   "id": "b043_ev2220_0105",
   "translation": "「有点怪，但确实好吃」"
  },
  {
   "id": "b043_ev2220_0110",
   "translation": "「延误大概两周，我们也考虑过住周租公寓……」"
  },
  {
   "id": "b043_ev2220_0156",
   "translation": "「嗯。希望陆斗君和步梦尽量变得要好，才安排两人同住一间」"
  },
  {
   "id": "b043_ev2220_0180",
   "translation": "「是啊。活蹦乱跳的步梦就这样回家了嘛……」"
  },
  {
   "id": "b043_ev2220_0187",
   "translation": "「这不就是说，这1个月让人特别难忘吗？」"
  },
  {
   "id": "b043_ev2220_0188",
   "translation": "「所以让我们住一起……？」"
  },
  {
   "id": "b043_ev2220_0194",
   "translation": "「我回来了，爸爸妈妈」"
  },
  {
   "id": "b043_ev2220_0195",
   "translation": "「总之，近期要好好向琉伍学长道谢和道歉」"
  },
  {
   "id": "b043_ev2220_0196",
   "translation": "「其中最难忘的是……？」"
  },
  {
   "id": "b043_ev2220_0227",
   "translation": "良子小姐温柔地搂住轻轻挨近的步梦。"
  },
  {
   "id": "b043_ev2220_0239",
   "translation": "不过现在，我们可比兄妹还要亲近了……",
   "note": "おにいちゃん以上に=超出兄妹关系"
  },
  {
   "id": "b043_ev2220_0248",
   "translation": "『不过，只能在梦里约会……。』"
  },
  {
   "id": "b043_ev2220_0268",
   "translation": "「嗯。别看我这样，排球还不错哦」"
  },
  {
   "id": "b043_ev2220_0273",
   "translation": "「嘛，我知道陆斗什么项目都能应付……真的没问题吗？」"
  },
  {
   "id": "b043_ev2220_0275",
   "translation": "「我也会应援」"
  }
 ]
}